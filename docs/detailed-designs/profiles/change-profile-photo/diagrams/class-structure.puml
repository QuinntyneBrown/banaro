@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Change profile photo

package "Frontend — banaro application and api library" {
  class ChangePhotoDialog {
    -api: ProfilesApi
    -check: PhotoFileCheck
    +state: 'default' | 'busy' | 'invalid' | 'failed'
    +file: File | null
    +crop: CropRect | null
    +progress: number
    +choose(file: File): void
    +save(): void
    +cancel(): void
    +remove(): void
  }
  class PhotoFileCheck {
    +check(file: File): Promise<PhotoCheckResult>
  }
  interface ProfilesApi {
    +uploadPhoto(file: File, crop: CropRect): Observable<HttpEvent<ProfilePhoto>>
    +getPhoto(id: string): Observable<ProfilePhoto>
    +removePhoto(): Observable<void>
  }
  class HttpProfilesApi
  class ProfilePhoto {
    +id: string
    +status: 'pending' | 'ready' | 'rejected'
    +url: string | null
  }
  class CropRect {
    +x: number
    +y: number
    +size: number
  }
}

package "Backend — Banaro API and Worker" {
  class ProfilePhotoRoutes {
    +POST(request: UploadProfilePhotoRequest): ProfilePhotoResource
    +GET(photo: ProfilePhoto): ProfilePhotoResource
    +DELETE(): Response
    +serve(photo: ProfilePhoto): Response
  }
  class UploadProfilePhotoRequest {
    +schema: ZodObject
  }
  class UploadProfilePhoto {
    +handle(builder: Builder, file: UploadedFile, crop: unknown[]): ProfilePhoto
  }
  class RemoveProfilePhoto {
    +handle(builder: Builder): void
  }
  class PhotoProcessor {
    +process(file: UploadedFile, crop: unknown[]): ProcessedImage
  }
  class ScanProfilePhoto {
    +photoId: number
    +handle(scanner: MediaScanner): void
  }
  interface MediaScanner {
    +scan(path: string): ScanResult
  }
  class Builder {
    +id: number
    +photo_id: string | null
  }
  class ProfilePhoto {
    +id: string
    +builder_id: number
    +path: string
    +status: PhotoStatus
    +scanned_at: Timestamp | null
  }
  enum PhotoStatus {
    Pending
    Ready
    Rejected
  }
  class ProfilePhotoPolicy {
    +view(user: User, photo: ProfilePhoto): boolean
    +delete(user: User, photo: ProfilePhoto): boolean
  }
  class ProfilePhotoResource
}

ChangePhotoDialog ..> ProfilesApi : uses
ChangePhotoDialog ..> PhotoFileCheck : checks file
HttpProfilesApi ..|> ProfilesApi
ProfilesApi ..> ProfilePhoto : returns
ChangePhotoDialog --> CropRect : holds
HttpProfilesApi ..> ProfilePhotoRoutes : HTTPS

ProfilePhotoRoutes ..> UploadProfilePhotoRequest : validates with
ProfilePhotoRoutes ..> ProfilePhotoPolicy : authorizes with
ProfilePhotoRoutes ..> UploadProfilePhoto : calls
ProfilePhotoRoutes ..> RemoveProfilePhoto : calls
ProfilePhotoRoutes ..> ProfilePhotoResource : returns
UploadProfilePhoto ..> PhotoProcessor : processes with
UploadProfilePhoto ..> ScanProfilePhoto : dispatches
ScanProfilePhoto ..> MediaScanner : scans with
ScanProfilePhoto --> ProfilePhoto : updates status
RemoveProfilePhoto --> Builder : clears photo
Builder "1" *-- "*" ProfilePhoto : photos
Builder "*" --> "0..1" ProfilePhoto : current photo
ProfilePhoto --> PhotoStatus : has
@enduml
