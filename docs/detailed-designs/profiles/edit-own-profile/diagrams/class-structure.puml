@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Edit own profile

package "Frontend — banaro application and api library" {
  class ProfileEditPage {
    -api: ProfilesApi
    -dialog: Dialog
    -toast: ToastService
    +form: FormGroup
    +state: 'loading' | 'default' | 'invalid' | 'submitting' | 'success' | 'error'
    +load(): void
    +save(): void
    +openChangePhoto(): void
  }
  class BuilderProfilePage {
    +profile: Signal<BuilderProfile>
    +isOwn(): boolean
  }
  interface ProfilesApi {
    +getOwnProfile(): Observable<OwnProfile>
    +updateOwnProfile(update: ProfileUpdate): Observable<OwnProfile>
  }
  class HttpProfilesApi
  class OwnProfile {
    +name: string
    +headline: string | null
    +neighbourhoodId: number
    +bio: string | null
    +skills: string[]
    +experience: ExperienceItem[]
    +links: ProfileLinkItem[]
    +openTo: OpenTo[]
    +buildingProjectId: string | null
    +neighbourhoods: NeighbourhoodOption[]
    +ownProjects: ProjectOption[]
  }
  class ToastService {
    +success(message: string): void
  }
}

package "Backend — Banaro API" {
  class OwnProfileRoutes {
    +GET(): OwnProfileResource
    +PUT(request: UpdateOwnProfileRequest): OwnProfileResource
  }
  class UpdateOwnProfileRequest {
    +schema: ZodObject
  }
  class GetOwnProfile {
    +handle(builder: Builder): Builder
  }
  class UpdateOwnProfile {
    +handle(builder: Builder, data: array): Builder
  }
  class SkillCatalogue {
    +resolve(entries: array): unknown[]<Skill>
  }
  class Builder {
    +id: number
    +name: string
    +headline: string | null
    +neighbourhood_id: number
    +bio: string | null
    +open_to: string[]
    +building_project_id: number | null
  }
  class ExperienceEntry {
    +id: number
    +builder_id: number
    +title: string
    +organisation: string | null
    +started_on: Timestamp
    +ended_on: Timestamp | null
    +position: number
  }
  class ProfileLink {
    +id: number
    +builder_id: number
    +label: string
    +url: string
    +position: number
  }
  class Skill {
    +id: number
    +name: string
  }
  class Project {
    +id: number
    +owner_id: number
    +name: string
  }
  class OwnProfileResource
  class ProfileUpdated {
    +builderId: number
  }
}

ProfileEditPage ..> ProfilesApi : uses
ProfileEditPage ..> ToastService : confirms save
HttpProfilesApi ..|> ProfilesApi
ProfilesApi ..> OwnProfile : returns
HttpProfilesApi ..> OwnProfileRoutes : HTTPS

OwnProfileRoutes ..> UpdateOwnProfileRequest : validates with
OwnProfileRoutes ..> GetOwnProfile : calls
OwnProfileRoutes ..> UpdateOwnProfile : calls
OwnProfileRoutes ..> OwnProfileResource : returns
UpdateOwnProfile ..> SkillCatalogue : resolves skills
UpdateOwnProfile ..> ProfileUpdated : dispatches
UpdateOwnProfile --> Builder : writes
Builder "1" *-- "*" ExperienceEntry : experience
Builder "1" *-- "*" ProfileLink : links
Builder "*" o-- "0..12" Skill : ordered skills
Builder "*" --> "0..1" Project : building
@enduml
