@startuml
title UML sequence behaviour — View the own profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — banaro application" #E0F2FE
  participant "BuilderProfilePage" as page
  participant "HttpDirectoryApi" as client
end box
box "Backend — Banaro API application" #D1FADF
  participant "BuilderProfileController" as controller
end box
box "Backend — Banaro Application and Domain" #ECFDF3
  participant "ViewBuilderProfile" as action
end box
box "Backend — Banaro Infrastructure" #FFF4E5
  database "Banaro database" as db
end box

actor -> page : Open own profile at /builders/{own id}
page -> client : getBuilder(id)
client -> controller : GET /api/v1/builders/{id}
controller -> action : handle(viewer, id)
action -> db : Load builder with skills, experience, links, project
db --> action : Builder
action -> action : Viewer owns the builder
action --> controller : Profile with isOwn = true, no match score
controller --> client : 200 BuilderProfileResource (actions: edit only)
client --> page : BuilderProfile
page --> actor : own state with "Edit profile", no "Say hello", "Report" or "Block" (L2-007 criterion 1)
actor -> page : Select "Edit profile"
page --> actor : Navigate to /profile/edit (see Load and save the profile)
@enduml
