@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Accept the code of conduct

package "Frontend — banaro application and api library" {
  class CodeOfConductPage {
    +sections: TocEntry[]
    +lastUpdated: string
  }
  class JoinPage {
    +consentLinkLabel: string
  }
  class AcceptCodeOfConductDialog {
    -api: TrustAndSafetyApi
    +version: string
    +state: 'default' | 'busy' | 'failed'
    +accept(): void
  }
  class codeOfConductGuard <<function>> {
    +canActivate(): boolean
  }
  interface TrustAndSafetyApi {
    +acceptCodeOfConduct(version: string): Observable<ConductAcceptanceSummary>
  }
  class HttpTrustAndSafetyApi
  class ConductAcceptanceSummary {
    +version: string
    +acceptedAt: string
  }
}

package "Backend — Banaro API" {
  class CodeOfConductRoutes {
    +POST(request: AcceptCodeOfConductRequest): ConductAcceptanceResource
  }
  class AcceptCodeOfConduct {
    +handle(member: User, version: string): ConductAcceptance
  }
  class CodeOfConductService {
    +currentVersion(): string
    +publishedOn(): Timestamp
    +requiresAcceptance(member: User): boolean
  }
  class ConductAcceptance {
    +id: number
    +user_id: number
    +version: string
    +accepted_at: Timestamp
  }
  class User {
    +id: number
  }
  class ConductAcceptanceResource
}

codeOfConductGuard ..> AcceptCodeOfConductDialog : opens
AcceptCodeOfConductDialog ..> TrustAndSafetyApi : uses
HttpTrustAndSafetyApi ..|> TrustAndSafetyApi
TrustAndSafetyApi ..> ConductAcceptanceSummary : returns
JoinPage ..> CodeOfConductPage : links in new tab
HttpTrustAndSafetyApi ..> CodeOfConductRoutes : HTTPS

CodeOfConductRoutes ..> AcceptCodeOfConduct : calls
CodeOfConductRoutes ..> ConductAcceptanceResource : returns
AcceptCodeOfConduct ..> CodeOfConductService : checks version
AcceptCodeOfConduct --> ConductAcceptance : inserts
CodeOfConductService ..> ConductAcceptance : queries
User "1" *-- "*" ConductAcceptance : acceptances
@enduml
