@startuml
title UML sequence behaviour — Unblock a builder from settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — banaro application" #E0F2FE
  participant "BlockedBuildersSection" as section
  participant "HttpTrustAndSafetyApi" as client
  participant "ToastService" as toast
end box
box "Backend — Banaro API application" #D1FADF
  participant "BlockController" as controller
end box
box "Backend — Banaro Application and Domain" #ECFDF3
  participant "BlockService" as service
  participant "UnblockBuilder" as action
end box
box "Backend — Banaro Infrastructure" #FFF4E5
  database "Banaro database" as db
end box

actor -> section : Open blocked list in /settings
section -> client : listBlocked()
client -> controller : GET /api/v1/blocks
controller -> service : blockedByMember(member)
service -> db : SELECT blocks WHERE blocker_id = member
db --> service : Blocks, newest first
controller --> client : 200 BlockedBuilderResource[]
client --> section : BlockedBuilder[]
section --> actor : Blocked list
actor -> section : Select "Unblock" on a row
section -> client : unblock(builderId)
client -> controller : DELETE /api/v1/blocks/{builder}
controller -> controller : Authenticate verified member, validate UnblockBuilderRequest
controller -> action : handle(blocker, builder)
alt member's block exists
  action -> db : DELETE block (blocker, blocked)
  action --> controller : Done
  controller --> client : 204
  client --> section : Success
  section -> section : Remove row
  section -> toast : Show success toast
  section --> actor : Visibility restored both ways (L2-032 criterion 3)
else no such block
  action --> controller : 404
  controller --> client : 404
  client --> section : Error
  section -> toast : Show danger toast with "Try again"
else server error
  controller --> client : 5xx, block unchanged
  client --> section : Error
  section -> toast : Show danger toast with "Try again"
end
@enduml
