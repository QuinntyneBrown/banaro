@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Block a builder

package "Frontend — banaro application and api library" {
  class BlockBuilderDialog {
    -api: TrustAndSafetyApi
    +builderId: string
    +state: 'default' | 'busy' | 'failed'
    +confirm(): void
  }
  class BlockedBuildersSection {
    -api: TrustAndSafetyApi
    +blocked: Signal<BlockedBuilder[]>
    +unblock(builderId: string): void
  }
  interface TrustAndSafetyApi {
    +block(builderId: string): Observable<void>
    +unblock(builderId: string): Observable<void>
    +listBlocked(): Observable<BlockedBuilder[]>
  }
  class HttpTrustAndSafetyApi
  class BlockedBuilder {
    +builderId: string
    +name: string
    +photoUrl: string | null
    +blockedAt: string
  }
}

package "Backend — Banaro API" {
  class BlockRoutes {
    +GET(request: Request): Page
    +POST(request: BlockBuilderRequest, builder: User): Response
    +DELETE(request: UnblockBuilderRequest, builder: User): Response
  }
  class BlockBuilder {
    +handle(blocker: User, blocked: User): Block
  }
  class UnblockBuilder {
    +handle(blocker: User, blocked: User): void
  }
  class BlockService {
    +isBlockedEitherWay(a: User, b: User): boolean
    +applyScope(query: Builder, viewer: User, userColumn: string): Builder
    +blockedByMember(blocker: User): unknown[]
  }
  class ExcludesBlockedUsers <<mixin>> {
    +scopeWithoutBlockedFor(query: Builder, viewer: User): Builder
  }
  class Block {
    +id: number
    +blocker_id: number
    +blocked_id: number
    +created_at: Timestamp
  }
  class User {
    +id: number
    +name: string
  }
  class BlockedBuilderResource
}

BlockBuilderDialog ..> TrustAndSafetyApi : uses
BlockedBuildersSection ..> TrustAndSafetyApi : uses
HttpTrustAndSafetyApi ..|> TrustAndSafetyApi
TrustAndSafetyApi ..> BlockedBuilder : returns
HttpTrustAndSafetyApi ..> BlockRoutes : HTTPS

BlockRoutes ..> BlockBuilder : calls
BlockRoutes ..> UnblockBuilder : calls
BlockRoutes ..> BlockedBuilderResource : returns
BlockRoutes ..> BlockService : lists via
BlockBuilder ..> BlockService : checks reverse block
BlockBuilder --> Block : creates
UnblockBuilder --> Block : deletes
ExcludesBlockedUsers ..> BlockService : delegates to
BlockService ..> Block : queries
Block "*" --> "1" User : blocker
Block "*" --> "1" User : blocked
@enduml
