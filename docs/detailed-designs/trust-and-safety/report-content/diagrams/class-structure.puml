@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Report a builder or content

package "Frontend — banaro application and api library" {
  class ReportDialog {
    -api: TrustAndSafetyApi
    +data: ReportDialogData
    +state: 'default' | 'busy' | 'invalid' | 'failed' | 'success'
    +send(): void
    +openBlockDialog(): void
  }
  class ReportDialogData {
    +subjectType: ReportSubjectType
    +subjectId: string
    +subjectName: string
  }
  interface TrustAndSafetyApi {
    +report(request: CreateReportRequest): Observable<ReportReceipt>
  }
  class HttpTrustAndSafetyApi
  class CreateReportRequest {
    +subjectType: 'builder' | 'project' | 'feedback' | 'message'
    +subjectId: string
    +reason: string
    +details?: string
  }
  class ReportReceipt {
    +reportId: string
    +receivedAt: string
  }
}

package "Backend — Banaro API" {
  class ReportRoutes {
    +POST(request: SubmitReportRequest): ReportReceiptResource
  }
  class SubmitReportRequest {
    +schema: ZodObject
  }
  class SubmitReport {
    +handle(reporter: User, type: ReportSubjectType, id: number, reason: ReportReason, details: ?string): Report
  }
  class ReportSubjectResolver {
    +resolve(viewer: User, type: ReportSubjectType, id: number): ReportSubject
  }
  class BlockService {
    +isBlockedEitherWay(a: User, b: User): boolean
  }
  class Report {
    +id: number
    +reporter_id: number
    +subject_type: ReportSubjectType
    +subject_id: number
    +reported_user_id: number
    +status: ReportStatus
    +last_submitted_at: Timestamp
  }
  class ReportSubmission {
    +id: number
    +report_id: number
    +reason: ReportReason
    +details: string | null
    +created_at: Timestamp
  }
  enum ReportReason {
    Harassment
    Spam
    Impersonation
    UnsafeContent
    CodeOfConductBreach
    Other
  }
  enum ReportSubjectType {
    Builder
    Project
    Feedback
    Message
  }
  enum ReportStatus {
    Open
    Actioned
    Dismissed
  }
  class ReportReceiptResource
}

ReportDialog ..> TrustAndSafetyApi : uses
ReportDialog --> ReportDialogData : receives
HttpTrustAndSafetyApi ..|> TrustAndSafetyApi
TrustAndSafetyApi ..> CreateReportRequest : sends
TrustAndSafetyApi ..> ReportReceipt : returns
HttpTrustAndSafetyApi ..> ReportRoutes : HTTPS

ReportRoutes ..> SubmitReportRequest : validates with
ReportRoutes ..> SubmitReport : calls
ReportRoutes ..> ReportReceiptResource : returns
SubmitReport ..> ReportSubjectResolver : resolves via
ReportSubjectResolver ..> BlockService : checks
SubmitReport --> Report : creates or merges
Report "1" *-- "1..*" ReportSubmission : submissions
ReportSubmission --> ReportReason : has
Report --> ReportSubjectType : has
Report --> ReportStatus : has
@enduml
