@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Hold conversations

Person(member, "Member", "Signed-in, verified builder")
System_Ext(mail, "Mail provider", "Delivers transactional e-mail")

System_Boundary(banaro, "Banaro") {
  Container(web, "Banaro Web", "Angular, SSR", "Messages page, inbox, thread, poller")
  Container(api, "Banaro API", "Laravel 11, PHP 8.3", "Inbox, threads, replies, read marks, participant scoping")
  Container(worker, "Banaro Worker", "Laravel Horizon", "Sends queued notifications")
  ContainerDb(db, "Banaro database", "Relational database", "Conversations, participants, messages, blocks")
  ContainerQueue(redis, "Redis", "Redis", "Sessions, rate-limit counters, Horizon queues")
}

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "GET, POST and PUT /api/v1/conversations/...; polls for new messages", "JSON/HTTPS")
Rel(api, db, "Reads threads, writes messages and read marks", "SQL")
Rel(api, redis, "Counts requests, queues notifications", "Redis protocol")
Rel(worker, redis, "Takes jobs from", "Redis protocol")
Rel(worker, mail, "Sends e-mail via", "Mailer contract")
@enduml
