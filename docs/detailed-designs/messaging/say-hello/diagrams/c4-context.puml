@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Say hello

Person(member, "Member", "Signed-in, verified builder who sends a first note")
Person(recipient, "Recipient", "Member who receives the first note")
System(banaro, "Banaro", "Connects Christian product builders in Toronto and the GTA")
System_Ext(mail, "Mail provider", "Delivers transactional e-mail")

Rel(member, banaro, "Sends a first message using", "HTTPS")
Rel(banaro, mail, "Sends new-message e-mail via", "Mailer contract")
Rel(mail, recipient, "Delivers e-mail to")
Rel(recipient, banaro, "Reads the in-app notification in", "HTTPS")
@enduml
