@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Say hello

package "Frontend — banaro application, components and api libraries" {
  class SayHelloDialog {
    -api: MessagingApi
    -toast: ToastService
    +data: SayHelloDialogData
    +state: 'default' | 'busy' | 'invalid' | 'failed'
    +message: FormControl<string>
    -clientMessageId: string
    +send(): void
    +cancel(): void
  }
  class SayHelloDialogData {
    +recipient: BuilderSummary
    +suggestionId: string | null
  }
  class ToastService {
    +success(title: string, body?: string): void
  }
  interface MessagingApi {
    +startConversation(input: StartConversationInput): Observable<ConversationRef>
  }
  class HttpMessagingApi
  class InMemoryMessagingApi
  class StartConversationInput {
    +recipientId: string
    +body: string
    +clientMessageId: string
  }
  class ConversationRef {
    +conversationId: string
    +created: boolean
  }
}

package "Backend — Banaro API" {
  class ConversationRoutes {
    +POST(request: StartConversationRequest): ConversationResource
  }
  class StartConversationRequest {
    +schema: ZodObject
  }
  class StartConversation {
    +handle(sender: User, recipient: User, body: string, clientMessageId: string): StartConversationResult
  }
  class StartConversationResult {
    +conversation: Conversation
    +message: Message
    +created: boolean
  }
  class FirstMessageLimiter {
    +attempt(sender: User): boolean
    +availableIn(sender: User): number
  }
  class BlockService <<TrustAndSafety>> {
    +isBlockedEitherWay(a: User, b: User): boolean
  }
  class Conversation {
    +id: number
    +pair_key: string
    +last_message_id: number | null
    +last_message_at: Timestamp | null
  }
  class ConversationParticipant {
    +conversation_id: number
    +user_id: number
    +last_read_message_id: number | null
  }
  class Message {
    +id: number
    +conversation_id: number
    +sender_id: number
    +body: string
    +client_message_id: string
    +created_at: Timestamp
  }
  class ConversationResource
  class ConversationStarted <<event>>
  class NewMessageNotification
}

SayHelloDialog ..> MessagingApi : uses
SayHelloDialog ..> ToastService : confirms with
SayHelloDialog --> SayHelloDialogData : data
HttpMessagingApi ..|> MessagingApi
InMemoryMessagingApi ..|> MessagingApi
MessagingApi ..> StartConversationInput : takes
MessagingApi ..> ConversationRef : returns
HttpMessagingApi ..> ConversationRoutes : HTTPS

ConversationRoutes ..> StartConversationRequest : validates with
ConversationRoutes ..> StartConversation : calls
ConversationRoutes ..> ConversationResource : returns
StartConversation ..> BlockService : checks
StartConversation ..> FirstMessageLimiter : limits with
StartConversation ..> StartConversationResult : returns
StartConversation ..> ConversationStarted : dispatches
StartConversation ..> NewMessageNotification : queues
StartConversation --> Conversation : creates or reuses
Conversation "1" *-- "2" ConversationParticipant : participants
Conversation "1" *-- "*" Message : messages
@enduml
