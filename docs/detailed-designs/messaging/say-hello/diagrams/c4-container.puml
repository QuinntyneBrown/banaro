@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Say hello

Person(member, "Member", "Signed-in, verified builder")
System_Ext(mail, "Mail provider", "Delivers transactional e-mail")

System_Boundary(banaro, "Banaro") {
  Container(web, "Banaro Web", "Angular, SSR", "say-hello dialog, success toast")
  Container(api, "Banaro API", "Next.js 16, Node 22", "Block, limit and idempotence rules; stores the conversation")
  Container(worker, "Banaro Worker", "BullMQ worker", "Sends queued notifications")
  ContainerDb(db, "Banaro database", "Relational database", "Conversations, participants, messages, blocks, notifications")
  ContainerQueue(redis, "Redis", "Redis", "Sessions, first-message counters, BullMQ queues")
}

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "POST /api/v1/conversations", "JSON/HTTPS")
Rel(api, db, "Writes conversation and message", "SQL")
Rel(api, redis, "Counts first messages, queues notification", "Redis protocol")
Rel(worker, redis, "Takes jobs from", "Redis protocol")
Rel(worker, db, "Records database notification", "SQL")
Rel(worker, mail, "Sends e-mail via", "Mailer contract")
@enduml
