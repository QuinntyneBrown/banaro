@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Verify e-mail address

package "Frontend — banaro application and api library" {
  class VerifyEmailPage {
    -api: IdentityApi
    -session: SessionStore
    +state: 'default' | 'success' | 'error'
    +email: Signal<string | null>
    +resend(): void
  }
  class verifyEmailResolver <<ResolveFn>> {
    +resolve(route): Observable<'success' | 'error' | 'default'>
  }
  class emailVerificationInterceptor <<HttpInterceptorFn>> {
    +intercept(req, next): Observable<HttpEvent>
  }
  class memberGuard <<CanMatchFn>>
  class SessionStore {
    +member: Signal<MemberSession | null>
  }
  interface IdentityApi {
    +verifyEmail(link: VerificationLink): Observable<void>
    +resendVerification(request: ResendVerificationRequest): Observable<void>
  }
  class HttpIdentityApi
  class VerificationLink {
    +token: string
    +expires: number
    +signature: string
  }
  class ResendVerificationRequest {
    +token?: string
    +email?: string
  }
}

package "Backend — Banaro API" {
  class EmailVerificationRoutes {
    +POST(request: VerifyEmailRequest): Response
  }
  class VerificationNotificationRoutes {
    +POST(request: ResendVerificationEmailRequest): Response
  }
  class VerifyEmail {
    +handle(link: VerificationLinkData): User
  }
  class ResendVerificationEmail {
    +handle(data: ResendData, sessionUser: User | null): void
  }
  class EmailVerificationService {
    +issue(user: User): string
    +consume(token: string, expires: number, signature: string): User
    -sign(token: string, expires: number): string
  }
  class RequireVerifiedEmail {
    +run(ctx: Ctx, next: Next): Promise<Response>
  }
  class User {
    +id: number
    +email: string
    +email_verified_at: Timestamp | null
    +hasVerifiedEmail(): boolean
    +markEmailAsVerified(): void
  }
  class EmailVerificationToken {
    +id: number
    +user_id: number
    +token_hash: string
    +expires_at: Timestamp
    +used_at: Timestamp | null
    +isUsable(): boolean
  }
  class VerifyEmailNotification {
    +link: string
    +via(): string[]
  }
}

VerifyEmailPage ..> IdentityApi : uses
verifyEmailResolver ..> IdentityApi : uses
VerifyEmailPage ..> SessionStore : reads
memberGuard ..> SessionStore : reads
HttpIdentityApi ..|> IdentityApi
IdentityApi ..> VerificationLink : sends
IdentityApi ..> ResendVerificationRequest : sends
HttpIdentityApi ..> EmailVerificationRoutes : HTTPS
HttpIdentityApi ..> VerificationNotificationRoutes : HTTPS

EmailVerificationRoutes ..> VerifyEmail : calls
VerificationNotificationRoutes ..> ResendVerificationEmail : calls
VerifyEmail ..> EmailVerificationService : consume()
ResendVerificationEmail ..> EmailVerificationService : issue()
ResendVerificationEmail ..> VerifyEmailNotification : queues
EmailVerificationService --> EmailVerificationToken : creates / locks
RequireVerifiedEmail ..> User : checks
User "1" *-- "*" EmailVerificationToken : verificationTokens
@enduml
