@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Verify e-mail address

Person(visitor, "Visitor", "Joined Banaro; e-mail address not yet verified")
System_Ext(mail, "Mail provider", "Delivers transactional e-mail")

System_Boundary(banaro, "Banaro") {
  Container(web, "Banaro Web", "Angular, SSR", "Verify-email page; resolver checks the link during SSR")
  Container(api, "Banaro API", "Laravel 11, PHP 8.3", "Link checks, resend limit, verified-member gate")
  Container(worker, "Banaro Worker", "Laravel Horizon", "Sends queued e-mail")
  ContainerDb(db, "Banaro database", "Relational database", "users, email_verification_tokens")
  ContainerQueue(redis, "Redis", "Redis", "Sessions, rate-limit counters, Horizon queues")
}

Rel(visitor, web, "Uses", "HTTPS")
Rel(web, api, "POST /api/v1/email/verify and /email/verification-notification", "JSON/HTTPS")
Rel(api, db, "Locks and updates tokens, marks accounts verified", "SQL")
Rel(api, redis, "Counts resends, queues e-mail", "Redis protocol")
Rel(worker, redis, "Takes jobs from", "Redis protocol")
Rel(worker, mail, "Sends e-mail via", "Mailer contract")
@enduml
