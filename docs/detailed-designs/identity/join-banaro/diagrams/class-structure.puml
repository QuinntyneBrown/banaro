@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Join Banaro

package "Frontend — banaro application and api library" {
  class JoinPage {
    -api: IdentityApi
    +form: FormGroup<JoinForm>
    +state: 'default' | 'invalid' | 'submitting' | 'success'
    +submittedEmail: Signal<string>
    +submit(): void
    +resendLink(): void
  }
  interface IdentityApi {
    +join(request: JoinRequest): Observable<void>
  }
  class HttpIdentityApi
  class JoinRequest {
    +name: string
    +email: string
    +password: string
    +agreedToCodeOfConduct: boolean
  }
  class ApiProblem {
    +code: string
    +message: string
    +errors: Record<string, string[]>
  }
}

package "Backend — Banaro API" {
  class JoinRoutes {
    +POST(request: JoinBanaroRequest): Response
  }
  class JoinBanaroRequest {
    +schema: ZodObject
    +toData(): JoinData
  }
  class JoinData {
    +name: string
    +email: string
    +password: string
  }
  class PasswordPolicy {
    +schema: ZodObject
  }
  class NotCommonPassword {
    +refine(value: string): boolean
  }
  class JoinBanaro {
    +handle(data: JoinData): void
  }
  class EmailVerificationService {
    +issue(user: User): string
  }
  class User {
    +id: number
    +name: string
    +email: string
    +password: string
    +email_verified_at: Timestamp | null
    +code_of_conduct_version: string
    +code_of_conduct_accepted_at: Timestamp
    +hasVerifiedEmail(): boolean
  }
  class VerifyEmailNotification {
    +link: string
    +via(): string[]
  }
  class AccountAlreadyExistsNotification {
    +via(): string[]
  }
}

JoinPage ..> IdentityApi : uses
HttpIdentityApi ..|> IdentityApi
IdentityApi ..> JoinRequest : sends
IdentityApi ..> ApiProblem : fails with
HttpIdentityApi ..> JoinRoutes : HTTPS

JoinRoutes ..> JoinBanaroRequest : validates with
JoinRoutes ..> JoinBanaro : calls
JoinBanaroRequest ..> PasswordPolicy : password rules
PasswordPolicy *-- NotCommonPassword
JoinBanaroRequest ..> JoinData : builds
JoinBanaro ..> JoinData : handles
JoinBanaro --> User : finds / creates
JoinBanaro ..> EmailVerificationService : issues link
JoinBanaro ..> VerifyEmailNotification : queues
JoinBanaro ..> AccountAlreadyExistsNotification : queues
@enduml
