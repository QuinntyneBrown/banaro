@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Recover a forgotten password

Person(person, "Visitor", "Person who has forgotten a Banaro password")
System(banaro, "Banaro", "Connects Christian product builders in Toronto and the GTA")
System_Ext(mail, "Mail provider", "Delivers transactional e-mail")

Rel(person, banaro, "Requests a reset link and chooses a new password using", "HTTPS")
Rel(banaro, mail, "Sends reset links via, only for existing accounts", "Mailer contract")
Rel(mail, person, "Delivers e-mail to")
@enduml
