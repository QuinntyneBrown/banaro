@startuml
title UML sequence behaviour — Reset the password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — banaro application" #E0F2FE
  participant "resetPasswordResolver" as resolver
  participant "ResetPasswordPage" as page
  participant "HttpIdentityApi" as client
end box
box "Backend — Banaro API application" #D1FADF
  participant "PasswordResetController" as controller
end box
box "Backend — Banaro Application and Domain" #ECFDF3
  participant "ResetPassword" as action
  participant "SessionRevocationService" as revoke
end box
box "Backend — Banaro Infrastructure" #FFF4E5
  database "Banaro database" as db
  queue "Redis" as redis
end box

actor -> resolver : Open /reset-password?token&email (server-side render)
resolver -> client : checkPasswordReset(link)
client -> controller : POST /api/v1/reset-password/check
controller -> db : CheckPasswordResetLink: token hash matches, created under 60 minutes ago
alt expired, used or tampered
  controller --> client : 422 reset_link_invalid
  client --> resolver : Error
  resolver --> page : 'error'
  page --> actor : "This link has expired" with "Send a new link" (L2-004 criterion 3)
else valid link
  controller --> client : 204
  resolver --> page : 'default'
  page --> actor : "Choose a new password for {email}"
  actor -> page : Enter and confirm new password; select "Update password"
  page -> page : Client checks: 12 characters, confirmation matches
  page -> page : submitting state, "Updating…"
  page -> client : resetPassword(request)
  client -> controller : POST /api/v1/reset-password
  controller -> controller : Validate ResetPasswordRequest with PasswordPolicy and confirmed
  alt short, common or unconfirmed password
    controller --> client : 422 field errors (L2-004 criterion 4)
    client --> page : ApiProblem
    page --> actor : invalid state with the specific problem
  else rules pass
    controller -> action : handle(data)
    action -> db : BEGIN; check token again
    alt token no longer valid
      action -> db : ROLLBACK
      action --> controller : 422 reset_link_invalid
      controller --> client : 422
      client --> page : ApiProblem
      page --> actor : error state (L2-004 criterion 3)
    else new password equals the current one
      action -> db : ROLLBACK
      action --> controller : Field error on password
      controller --> client : 422
      client --> page : ApiProblem
      page --> actor : invalid state, same-password message (L2-004 criterion 4)
    else accepted
      action -> db : UPDATE users SET password = new hash, rotate remember_token
      action -> db : DELETE token; link is single-use
      action -> db : COMMIT
      action -> revoke : revokeAll(user) (L2-004 criterion 2)
      revoke -> redis : Older sessions hold the old password hash; AuthenticateSession logs each out on its next request
      action --> controller : Done
      controller --> client : 204
      client --> page : Success
      page --> actor : "Password updated" with "Sign in"
    end
  end
end
@enduml
