@startuml
title UML sequence behaviour — Run the axe check in the pipeline
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as actor
box "Pipeline — .ci" #FFF4E5
  participant "a11y stage" as stage
end box
box "End-to-end — e2e" #FFF4E5
  participant "a11y/axe.spec.ts" as spec
  participant "routes.manifest.ts" as manifest
  participant "Page object" as po
  participant "AxeBuilder" as axe
end box
participant "Chromium" as chrome
box "Frontend — banaro application" #E0F2FE
  participant "Banaro Web (test build)" as web
end box

actor -> stage : Push a UI change
stage -> spec : npx playwright test a11y --project=chromium
spec -> manifest : Read entries and states
loop each entry and state, theme in light/dark
  spec -> chrome : Set data-theme
  spec -> po : Reach state (open the dialog for dialog entries)
  po -> chrome : Navigate and interact
  chrome -> web : Load
  web --> chrome : Rendered state
  spec -> axe : withTags(wcag2a, wcag2aa, wcag21a, wcag21aa, wcag22aa).analyze()
  axe -> chrome : Evaluate rules incl. color-contrast, landmarks, names
  chrome --> axe : Results
  axe --> spec : Violations
  spec -> spec : Expect zero violations (L2-050 criterion 1)
end
alt any violation
  spec --> stage : Failures naming rule, element and route
  stage --> actor : Stage fails
else none
  stage --> actor : Stage passes
end
@enduml
