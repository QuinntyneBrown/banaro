@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View a builder profile

Person(member, "Member", "Signed-in, verified builder")
Person(visitor, "Visitor", "Not signed in")

System_Boundary(banaro, "Banaro") {
  Container(web, "Banaro Web", "Angular, SSR", "Builder profile page; say-hello, report and block dialogs")
  Container(api, "Banaro API", "Laravel 11, PHP 8.3", "Builds a per-viewer profile, hides private fields")
  ContainerDb(db, "Banaro database", "Relational database", "Builders, skills, experience, projects, privacy settings, blocks")
  ContainerDb(redis, "Redis", "Redis", "Sessions, cached match scores")
}

Rel(member, web, "Uses", "HTTPS")
Rel(visitor, web, "Uses", "HTTPS")
Rel(web, api, "GET /api/v1/builders/{id}", "JSON/HTTPS")
Rel(api, db, "Reads profile, privacy and blocks", "SQL")
Rel(api, redis, "Reads session and match scores", "Redis protocol")
@enduml
