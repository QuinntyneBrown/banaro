@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View a builder profile

Container(web, "Banaro Web", "Angular", "BuilderProfilePage, MatchPanel, HttpDirectoryApi")
ContainerDb(db, "Banaro database", "Relational database", "builders, skills, experience_entries, projects, privacy_settings, blocks")
ContainerDb(redis, "Redis", "Redis", "Cached match scores")

Container_Boundary(api, "Banaro API") {
  Component(ctrl, "BuilderProfileController", "Laravel controller", "GET /builders/{builder} (api_public.php)")
  Component(req, "ShowBuilderProfileRequest", "Form request", "Public id shape, viewer")
  Component(action, "ViewBuilderProfile", "Action", "Resolves, hides, enriches, sets actions")
  Component(visibility, "ProfileVisibility", "Settings filter (L2-036)", "canView, visibleFields")
  Component(blocks, "Block scope", "Trust-and-safety scope (L2-032)", "Blocks in either direction")
  Component(match, "MatchScoreService", "Matching domain service (L2-022)", "Score and reasons")
  Component(distance, "DistanceService", "Domain service", "Centroid distance, 5 km rounding for City only")
  Component(presence, "PresenceService", "Domain service", "Online status")
  Component(models, "Builder / Skill / ExperienceEntry / Project", "Eloquent models", "Profile content")
  Component(resources, "BuilderProfileResource / PublicBuilderProfileResource", "API resources", "Visible fields only")
}

Rel(web, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, req, "Validates with")
Rel(ctrl, action, "Calls handle()")
Rel(ctrl, resources, "Returns")
Rel(action, models, "Loads by public_id")
Rel(action, blocks, "Checks")
Rel(action, visibility, "Asks canView and visibleFields")
Rel(action, match, "Calls scoreFor()")
Rel(action, distance, "Calls between()")
Rel(action, presence, "Calls statusFor()")
Rel(match, redis, "Reads cached scores", "Redis protocol")
Rel(models, db, "Reads", "SQL")
@enduml
