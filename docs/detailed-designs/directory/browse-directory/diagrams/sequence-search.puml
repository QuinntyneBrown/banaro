@startuml
title UML sequence behaviour — Search the directory
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member or visitor" as actor
box "Frontend — banaro application" #E0F2FE
  participant "DirectoryPage" as page
  participant "HttpDirectoryApi" as client
end box
box "Backend — Banaro API application" #D1FADF
  participant "BuilderDirectoryController" as controller
end box
box "Backend — Banaro Application and Domain" #ECFDF3
  participant "SearchDirectory" as action
  participant "SearchNormalizer" as normalizer
end box
box "Backend — Banaro Infrastructure" #FFF4E5
  database "Banaro database" as db
end box

actor -> page : Type "José" into "Name, skill or project"
page -> page : debounceTime(250), distinctUntilChanged (L2-009 criterion 4)
page -> page : Write q to the URL, reset page to 1
page -> client : searchBuilders({ q: "José", sort, page: 1 })
client -> controller : GET /api/v1/builders?q=Jos%C3%A9&page=1
controller -> action : handle(viewer, query)
action -> normalizer : normalise("José")
normalizer --> action : "jose"
action -> db : Match search_text (name, skills, project names) with the search index
db --> action : Matching page and total
action --> controller : Paginator
controller --> client : 200 DirectoryPageResource
alt success
  client --> page : DirectoryResultPage
  page --> actor : Results; the polite live region announces the new count
else server failure
  client --> page : Error
  page --> actor : error state with "Try again"
  actor -> page : Select "Try again"
  page -> client : searchBuilders(same query)
end
@enduml
