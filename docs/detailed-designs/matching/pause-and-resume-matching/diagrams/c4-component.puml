@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Pause and resume matching

Container(web, "Banaro Web", "Angular", "MatchingPage, PauseMatchingDialog, HttpMatchingApi")
ContainerDb(db, "Banaro database", "Relational database", "matching_preferences")
Container(worker, "Banaro Worker", "Laravel", "GenerateSuggestionsForMember, MatchCandidateService")

Container_Boundary(api, "Banaro API") {
  Component(ctrl, "MatchingPauseController", "Laravel controller", "PUT and DELETE /matching/pause")
  Component(req, "PauseMatchingRequest / ResumeMatchingRequest", "Form requests", "Authorize the member, reject body fields")
  Component(pause, "PauseMatching", "Action", "Locks, sets paused and paused_at")
  Component(resume, "ResumeMatching", "Action", "Locks, sets active, clears paused_at")
  Component(model, "MatchingPreference", "Eloquent model", "status, paused_at")
  Component(resource, "MatchingPreferenceResource", "API resource", "MatchingPreferences JSON shape")
}

Rel(web, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, req, "Validates with")
Rel(ctrl, pause, "Calls handle()")
Rel(ctrl, resume, "Calls handle()")
Rel(ctrl, resource, "Returns")
Rel(pause, model, "Locks and updates")
Rel(resume, model, "Locks and updates")
Rel(model, db, "Reads and writes", "SQL")
Rel(worker, db, "Skips paused members", "SQL")
@enduml
