@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Generate weekly suggestions

Person(member, "Member", "Active matching member")
System(banaro, "Banaro", "Suggests three nearby, compatible builders every Monday")
