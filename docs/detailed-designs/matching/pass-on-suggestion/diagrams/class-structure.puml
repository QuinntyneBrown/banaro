@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Pass on a suggestion

package "Frontend — banaro application and api library" {
  class MatchingPage {
    +pass(card: MatchSuggestionCard): void
    +load(): void
  }
  class PassSuggestionDialog {
    -api: MatchingApi
    +data: MatchSuggestionCard
    +state: 'default' | 'busy' | 'failed'
    +reason: PassReason | null
    +confirm(): void
  }
  interface MatchingApi {
    +passSuggestion(id: string, reason?: PassReason): Observable<MatchSuggestionCard>
  }
  class HttpMatchingApi
  enum "PassReason" as FePassReason {
    not_right_skills
    too_far
    not_looking_now
    other
  }
}

package "Backend — Banaro API" {
  class MatchSuggestionPassRoutes {
    +POST(request: PassSuggestionRequest, suggestion: MatchSuggestion): MatchSuggestionResource
  }
  class PassSuggestionRequest {
    +schema: ZodObject
  }
  class MatchSuggestionPolicy {
    +pass(member: User, suggestion: MatchSuggestion): boolean
  }
  class PassOnSuggestion {
    +handle(member: User, suggestion: MatchSuggestion, reason: PassReason | null): MatchSuggestion
  }
  class MatchSuggestion {
    +id: number
    +user_id: number
    +candidate_user_id: number
    +status: MatchSuggestionStatus
    +pass_reason: PassReason | null
    +acted_at: Timestamp | null
  }
  enum PassReason {
    NotRightSkills
    TooFar
    NotLookingNow
    Other
  }
  enum MatchSuggestionStatus {
    Suggested
    Contacted
    Passed
  }
  class MatchSuggestionResource
  class MatchScoreService {
    +scoreFor(viewer: User, builder: Builder): MatchScore
  }
}

MatchingPage ..> PassSuggestionDialog : opens
PassSuggestionDialog ..> MatchingApi : uses
HttpMatchingApi ..|> MatchingApi
MatchingApi ..> FePassReason
HttpMatchingApi ..> MatchSuggestionPassRoutes : HTTPS

MatchSuggestionPassRoutes ..> PassSuggestionRequest : validates with
MatchSuggestionPassRoutes ..> MatchSuggestionPolicy : authorizes
MatchSuggestionPassRoutes ..> PassOnSuggestion : calls
MatchSuggestionPassRoutes ..> MatchSuggestionResource : returns
PassOnSuggestion --> MatchSuggestion : locks and updates
MatchSuggestion --> MatchSuggestionStatus : has
MatchSuggestion --> PassReason : pass_reason
MatchScoreService ..> MatchSuggestion : reads pass reasons (L2-024)
@enduml
