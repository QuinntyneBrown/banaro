@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Pass on a suggestion

Container(web, "Banaro Web", "Angular", "MatchingPage, PassSuggestionDialog, HttpMatchingApi")
ContainerDb(db, "Banaro database", "Relational database", "match_suggestions")
Container(worker, "Banaro Worker", "Laravel", "MatchCandidateService, MatchScoreService")

Container_Boundary(api, "Banaro API") {
  Component(ctrl, "MatchSuggestionPassController", "Laravel controller", "POST /matching/suggestions/{suggestion}/pass")
  Component(req, "PassSuggestionRequest", "Form request", "Optional PassReason, ignores other fields")
  Component(policy, "MatchSuggestionPolicy", "Policy", "Owner only")
  Component(action, "PassOnSuggestion", "Action", "Locks, sets passed, reason and acted_at")
  Component(model, "MatchSuggestion", "Eloquent model", "Status, pass reason")
  Component(resource, "MatchSuggestionResource", "API resource", "MatchSuggestionCard JSON shape")
}

Rel(web, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, req, "Validates with")
Rel(ctrl, policy, "Authorizes with")
Rel(ctrl, action, "Calls handle()")
Rel(ctrl, resource, "Returns")
Rel(action, model, "Locks and updates")
Rel(model, db, "Reads and writes", "SQL")
Rel(worker, db, "Reads passes for exclusion and weighting", "SQL")
@enduml
