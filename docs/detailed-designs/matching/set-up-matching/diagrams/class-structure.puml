@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Set up matching

package "Frontend — banaro application and api library" {
  class MatchingSetupPage {
    -api: MatchingApi
    +state: 'default' | 'invalid' | 'submitting' | 'success'
    +form: FormGroup
    +saved: Signal<MatchingPreferences | null>
    +submit(): void
  }
  class matchingSetUpGuard <<CanActivateFn>> {
    +canActivate(): boolean | UrlTree
  }
  interface MatchingApi {
    +getPreferences(): Observable<MatchingPreferences>
    +savePreferences(request: SaveMatchingPreferencesRequest): Observable<MatchingPreferences>
    +getOverview(): Observable<MatchingOverview>
  }
  class HttpMatchingApi
  class SaveMatchingPreferencesRequest {
    +buildingSummary: string
    +lookingFor: MatchRole[]
    +skills: string[]
    +ventureStage: string | null
    +availability: string | null
    +maxDistanceKm: number
    +weeklyEmail: boolean
  }
  class MatchingPreferences {
    +status: 'active' | 'paused'
    +nextRunOn: string
  }
}

package "Backend — Banaro API" {
  class MatchingPreferenceRoutes {
    +GET(request: Request): MatchingPreferenceResource
    +PUT(request: SaveMatchingPreferencesRequest): MatchingPreferenceResource
  }
  class "SaveMatchingPreferencesRequest " as SaveReq {
    +schema: ZodObject
  }
  class SaveMatchingPreferences {
    +handle(member: User, data: array): MatchingPreference
  }
  class MatchingScheduleService {
    +nextRunDate(now: Timestamp): Timestamp
    +isoWeekOf(instant: Timestamp): string
  }
  class EmailPreferenceService {
    +set(member: User, category: EmailCategory, enabled: bool): void
  }
  class User {
    +id: number
  }
  class MatchingPreference {
    +id: number
    +user_id: number
    +building_summary: string
    +looking_for: string[]
    +skills: string[]
    +venture_stage: VentureStage | null
    +availability: Availability | null
    +max_distance_km: number
    +status: MatchingStatus
    +paused_at: Timestamp | null
  }
  enum MatchRole {
    CoFounder
    Advisor
    Contributor
  }
  enum MatchingStatus {
    Active
    Paused
  }
  class MatchingPreferenceResource
}

MatchingSetupPage ..> MatchingApi : uses
matchingSetUpGuard ..> MatchingApi : uses
HttpMatchingApi ..|> MatchingApi
MatchingApi ..> SaveMatchingPreferencesRequest : sends
MatchingApi ..> MatchingPreferences : returns
MatchingPreferences --|> SaveMatchingPreferencesRequest
HttpMatchingApi ..> MatchingPreferenceRoutes : HTTPS

MatchingPreferenceRoutes ..> SaveReq : validates with
MatchingPreferenceRoutes ..> SaveMatchingPreferences : calls
MatchingPreferenceRoutes ..> MatchingPreferenceResource : returns
SaveMatchingPreferences ..> MatchingScheduleService : next run
SaveMatchingPreferences ..> EmailPreferenceService : Matches category
SaveMatchingPreferences --> MatchingPreference : upserts
User "1" *-- "0..1" MatchingPreference : matchingPreference
MatchingPreference --> MatchRole : looking_for
MatchingPreference --> MatchingStatus : has
@enduml
