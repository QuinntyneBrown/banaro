@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — View a project

package "Frontend — banaro application, components and api libraries" {
  class ProjectDetailPage {
    -api: ProjectsApi
    +project: Signal<ProjectDetail | null>
    +feedback: Signal<FeedbackView[]>
    +state: 'loading' | 'default' | 'own' | 'empty' | 'error' | 'not-found'
    +retry(): void
    +loadEarlier(): void
    +askToSignIn(): void
  }
  class FeedbackItem {
    selector bn-feedback-item
    +item: InputSignal<FeedbackView>
  }
  interface ProjectsApi {
    +get(id: string): Observable<ProjectDetail>
    +feedback(id: string, page: number): Observable<Page<FeedbackView>>
  }
  class HttpProjectsApi
  class ProjectDetail {
    +id: string
    +name: string
    +summary: string
    +description: string
    +stage: ProjectStage
    +lookingFor: LookingForRole[]
    +link: string | null
    +owner: OwnerSummary
    +feedbackCount: number
    +permissions: ProjectPermissions
  }
  class ProjectPermissions {
    +edit: boolean
    +delete: boolean
    +giveFeedback: boolean
    +offerHelp: boolean
    +viewHelpOffers: boolean
  }
  class FeedbackView {
    +id: string
    +author: AuthorSummary
    +body: string
    +createdAt: string
    +hidden: boolean
    +reply: FeedbackReplyView | null
  }
}

package "Backend — Banaro API" {
  class ProjectRoutes {
    +GET(request: ShowProjectRequest, project: Project): ProjectResource
  }
  class FeedbackRoutes {
    +GET(request: ListFeedbackRequest, project: Project): Page
  }
  class ViewProject {
    +handle(project: Project): Project
  }
  class ListProjectFeedback {
    +handle(project: Project, viewer: User | null, page: int, perPage: int): Page
  }
  class ProjectPolicy {
    +update(user: User, project: Project): boolean
    +delete(user: User, project: Project): boolean
    +giveFeedback(user: User | null, project: Project): boolean
    +offerHelp(user: User | null, project: Project): boolean
    +viewHelpOffers(user: User, project: Project): boolean
  }
  class BlockService {
    +applyScope(query, viewer: User, column: string): Builder
  }
  class Project {
    +id: number
    +owner_id: number
    +feedback_count: number
  }
  class Feedback {
    +id: number
    +project_id: number
    +author_id: number
    +body: string
    +reply_body: string | null
    +replied_at: Timestamp | null
    +hidden_at: Timestamp | null
    +scopeVisibleTo(query, viewer: User | null): Builder
  }
  class ProjectResource
  class FeedbackResource
}

ProjectDetailPage ..> ProjectsApi : uses
ProjectDetailPage ..> FeedbackItem : renders
HttpProjectsApi ..|> ProjectsApi
ProjectsApi ..> ProjectDetail : returns
ProjectsApi ..> FeedbackView : returns
ProjectDetail *-- ProjectPermissions
HttpProjectsApi ..> ProjectRoutes : HTTPS
HttpProjectsApi ..> FeedbackRoutes : HTTPS

ProjectRoutes ..> ViewProject : calls
ProjectRoutes ..> ProjectResource : returns
FeedbackRoutes ..> ListProjectFeedback : calls
FeedbackRoutes ..> FeedbackResource : returns
ProjectResource ..> ProjectPolicy : evaluates
ListProjectFeedback ..> BlockService : excludes blocked authors
ListProjectFeedback --> Feedback : queries
Project "1" *-- "*" Feedback : feedback
@enduml
