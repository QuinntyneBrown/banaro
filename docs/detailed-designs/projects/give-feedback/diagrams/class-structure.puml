@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Give feedback on a project

package "Frontend — banaro application and api library" {
  class GiveFeedbackDialog {
    -api: ProjectsApi
    +body: FormControl<string>
    +state: 'default' | 'busy' | 'invalid' | 'failed'
    +post(): void
  }
  class ReplyToFeedbackDialog {
    -api: ProjectsApi
    +body: FormControl<string>
    +state: 'default' | 'busy' | 'invalid' | 'failed'
    +send(): void
  }
  class ProjectDetailPage {
    +openGiveFeedback(): void
    +openReply(item: FeedbackView): void
    +hide(item: FeedbackView): void
  }
  interface ProjectsApi {
    +giveFeedback(projectId: string, body: string): Observable<FeedbackView>
    +replyToFeedback(projectId: string, feedbackId: string, body: string): Observable<FeedbackView>
    +hideFeedback(projectId: string, feedbackId: string): Observable<FeedbackView>
  }
  class HttpProjectsApi
}

package "Backend — Banaro API" {
  class FeedbackRoutes {
    +POST(request: GiveFeedbackRequest, project: Project): FeedbackResource
  }
  class FeedbackReplyRoutes {
    +POST(request: ReplyToFeedbackRequest, project: Project, feedback: Feedback): FeedbackResource
  }
  class FeedbackVisibilityRoutes {
    +POST(request: HideFeedbackRequest, project: Project, feedback: Feedback): FeedbackResource
  }
  class ProjectPolicy {
    +giveFeedback(user: User | null, project: Project): boolean
  }
  class FeedbackPolicy {
    +reply(user: User, feedback: Feedback): boolean
    +hide(user: User, feedback: Feedback): boolean
  }
  class BlockService {
    +isBlockedEitherWay(a: User, b: User): boolean
  }
  class GiveFeedback {
    +handle(author: User, project: Project, body: string): Feedback
  }
  class ReplyToFeedback {
    +handle(feedback: Feedback, body: string): Feedback
  }
  class HideFeedback {
    +handle(owner: User, feedback: Feedback): Feedback
  }
  class Project {
    +id: number
    +owner_id: number
    +feedback_count: number
    +last_activity_at: Timestamp
  }
  class Feedback {
    +id: number
    +project_id: number
    +author_id: number
    +body: string
    +reply_body: string | null
    +replied_at: Timestamp | null
    +hidden_at: Timestamp | null
    +hidden_by: number | null
    +hasReply(): boolean
  }
  class FeedbackResource
  class FeedbackReceivedNotification {
    +via(owner: User): string[]
    +toMail(owner: User): MailMessage
  }
}

GiveFeedbackDialog ..> ProjectsApi : uses
ReplyToFeedbackDialog ..> ProjectsApi : uses
ProjectDetailPage ..> GiveFeedbackDialog : opens
ProjectDetailPage ..> ReplyToFeedbackDialog : opens
ProjectDetailPage ..> ProjectsApi : hides via
HttpProjectsApi ..|> ProjectsApi
HttpProjectsApi ..> FeedbackRoutes : HTTPS

FeedbackRoutes ..> GiveFeedback : calls
FeedbackReplyRoutes ..> ReplyToFeedback : calls
FeedbackVisibilityRoutes ..> HideFeedback : calls
FeedbackRoutes ..> ProjectPolicy : authorize
FeedbackReplyRoutes ..> FeedbackPolicy : authorize
FeedbackVisibilityRoutes ..> FeedbackPolicy : authorize
ProjectPolicy ..> BlockService : blocked pair check
GiveFeedback ..> FeedbackReceivedNotification : queues
FeedbackRoutes ..> FeedbackResource : returns
Project "1" *-- "*" Feedback : feedback
@enduml
