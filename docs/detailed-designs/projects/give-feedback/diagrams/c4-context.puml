@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Give feedback on a project

Person(member, "Member", "Signed-in, verified builder who does not own the project")
Person(owner, "Owner", "Member who shared the project")
System(banaro, "Banaro", "Connects Christian product builders in Toronto and the GTA")
System_Ext(mail, "Mail provider", "Delivers transactional e-mail")

Rel(member, banaro, "Leaves feedback using", "HTTPS")
Rel(owner, banaro, "Reads, replies to and hides feedback using", "HTTPS")
Rel(banaro, mail, "Sends new-feedback e-mail via", "Mailer contract")
Rel(mail, owner, "Delivers e-mail to")
@enduml
