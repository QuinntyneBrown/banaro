@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Give feedback on a project

Person(member, "Member", "Gives feedback")
Person(owner, "Owner", "Replies to and hides feedback")
System_Ext(mail, "Mail provider", "Delivers transactional e-mail")

System_Boundary(banaro, "Banaro") {
  Container(web, "Banaro Web", "Angular, SSR", "give-feedback and reply dialogs, project page")
  Container(api, "Banaro API", "Laravel 11, PHP 8.3", "Rate limit, block check, feedback rules")
  Container(worker, "Banaro Worker", "Laravel Horizon", "Sends queued notifications")
  ContainerDb(db, "Banaro database", "Relational database", "Projects, feedback, blocks, notifications")
  ContainerQueue(redis, "Redis", "Redis", "Sessions, rate-limit counters, Horizon queues")
}

Rel(member, web, "Uses", "HTTPS")
Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "POST /feedback, PUT /reply and /hidden", "JSON/HTTPS")
Rel(api, db, "Writes feedback", "SQL")
Rel(api, redis, "Counts requests, queues notifications", "Redis protocol")
Rel(worker, redis, "Takes jobs from", "Redis protocol")
Rel(worker, db, "Records database notifications", "SQL")
Rel(worker, mail, "Sends e-mail via", "Mailer contract")
@enduml
