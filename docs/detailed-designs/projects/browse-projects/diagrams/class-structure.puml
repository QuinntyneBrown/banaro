@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Browse projects

package "Frontend — banaro application, components and api libraries" {
  class ProjectsPage {
    -api: ProjectsApi
    -router: Router
    +query: Signal<ProjectQuery>
    +results: Signal<ProjectSummary[]>
    +total: Signal<number>
    +state: 'loading' | 'default' | 'no-results' | 'error'
    +applyQuery(change: Partial<ProjectQuery>): void
    +removeFilter(name: string): void
    +clearFilters(): void
    +showMore(): void
    +retry(): void
  }
  class ProjectCard {
    selector bn-project-card
    +project: InputSignal<ProjectSummary>
  }
  interface ProjectsApi {
    +browse(query: ProjectQuery): Observable<Page<ProjectSummary>>
  }
  class HttpProjectsApi
  class ProjectQuery {
    +q: string | null
    +stage: ProjectStage | null
    +lookingFor: LookingForRole | null
    +page: number
  }
  class ProjectSummary {
    +id: string
    +name: string
    +owner: OwnerSummary
    +summary: string
    +stage: ProjectStage
    +lookingFor: LookingForRole[]
    +feedbackCount: number
  }
}

package "Backend — Banaro API" {
  class ProjectRoutes {
    +GET(request: BrowseProjectsRequest): Page
  }
  class BrowseProjectsRequest {
    +schema: ZodObject
  }
  class BrowseProjects {
    +handle(input: array, viewer: User | null): Page
  }
  class ProjectSearchService {
    +search(query: ProjectSearchQuery): Page
  }
  class ProjectSearchQuery {
    +text: string | null
    +stage: ProjectStage | null
    +lookingFor: LookingForRole | null
    +viewer: User | null
    +page: number
    +perPage: number
  }
  class BlockService {
    +applyScope(query, viewer: User, column: string): Builder
  }
  class Project {
    +id: number
    +owner_id: number
    +name: string
    +summary: string
    +stage: ProjectStage
    +feedback_count: number
    +last_activity_at: Timestamp
  }
  class ProjectLookingFor {
    +project_id: number
    +role: LookingForRole
  }
  class ProjectSummaryResource
}

ProjectsPage ..> ProjectsApi : uses
ProjectsPage ..> ProjectCard : renders
HttpProjectsApi ..|> ProjectsApi
ProjectsApi ..> ProjectQuery : sends
ProjectsApi ..> ProjectSummary : returns
HttpProjectsApi ..> ProjectRoutes : HTTPS

ProjectRoutes ..> BrowseProjectsRequest : validates with
ProjectRoutes ..> BrowseProjects : calls
ProjectRoutes ..> ProjectSummaryResource : returns
BrowseProjects ..> ProjectSearchQuery : builds
BrowseProjects ..> ProjectSearchService : calls
ProjectSearchService ..> BlockService : excludes blocked owners
ProjectSearchService --> Project : queries
Project "1" *-- "*" ProjectLookingFor : lookingFor
@enduml
