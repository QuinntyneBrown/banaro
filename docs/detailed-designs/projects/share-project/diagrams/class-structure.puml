@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Share a project

package "Frontend — banaro application and api library" {
  class ProjectNewPage {
    -api: ProjectsApi
    +form: FormGroup<ProjectFormControls>
    +state: 'default' | 'invalid' | 'submitting' | 'success'
    +created: Signal<ProjectDetail | null>
    +submit(): void
  }
  class ProjectFormModel {
    +build(initial?: ProjectDraft): FormGroup<ProjectFormControls>
    +applyErrors(form, errors: FieldErrors): void
  }
  interface ProjectsApi {
    +share(draft: ProjectDraft): Observable<ProjectDetail>
  }
  class HttpProjectsApi
  class ProjectDraft {
    +name: string
    +summary: string
    +description: string
    +stage: ProjectStage
    +lookingFor: LookingForRole[]
    +link: string | null
  }
}

package "Backend — Banaro API" {
  class ProjectRoutes {
    +POST(request: ShareProjectRequest): ProjectResource
  }
  class ShareProjectRequest {
    +schema: ZodObject
    +validated(): string[]
  }
  class ShareProject {
    +handle(owner: User, data: unknown[]): Project
  }
  class ProjectLimitReached {
    +code: 'project_limit'
    +status: 422
  }
  class User {
    +id: number
  }
  class Project {
    +id: number
    +owner_id: number
    +name: string
    +summary: string
    +description: string | null
    +stage: ProjectStage
    +link: string | null
    +feedback_count: number
    +last_activity_at: Timestamp
  }
  class ProjectLookingFor {
    +project_id: number
    +role: LookingForRole
  }
  enum ProjectStage {
    Idea
    Design
    Prototype
    Beta
    Pilot
    Launched
  }
  enum LookingForRole {
    CoFounder
    TechnicalCoFounder
    Contributor
    Advisor
    Designer
    Engineer
  }
  class ProjectResource
}

ProjectNewPage ..> ProjectsApi : uses
ProjectNewPage ..> ProjectFormModel : builds form with
HttpProjectsApi ..|> ProjectsApi
ProjectsApi ..> ProjectDraft : sends
HttpProjectsApi ..> ProjectRoutes : HTTPS

ProjectRoutes ..> ShareProjectRequest : validates with
ProjectRoutes ..> ShareProject : calls
ProjectRoutes ..> ProjectResource : returns
ShareProject ..> ProjectLimitReached : throws
ShareProject --> User : locks
ShareProject --> Project : creates
User "1" --> "0..10" Project : owns
Project "1" *-- "*" ProjectLookingFor : lookingFor
Project --> ProjectStage : has
ProjectLookingFor --> LookingForRole : has
@enduml
