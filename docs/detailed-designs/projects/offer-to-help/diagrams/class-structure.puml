@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Offer to help with a project

package "Frontend — banaro application, components and api libraries" {
  class OfferToHelpDialog {
    -api: ProjectsApi
    -toast: ToastService
    +roles: LookingForRole[]
    +form: FormGroup<OfferControls>
    +state: 'default' | 'busy' | 'invalid' | 'failed'
    +send(): void
  }
  class ProjectDetailPage {
    +offers: Signal<HelpOfferView[]>
    +openOfferToHelp(): void
    +answer(offer: HelpOfferView, decision: 'accepted' | 'declined'): void
  }
  class HelpOfferItem {
    selector bn-help-offer-item
    +offer: InputSignal<HelpOfferView>
  }
  interface ProjectsApi {
    +offerHelp(projectId: string, offer: HelpOfferDraft): Observable<HelpOfferView>
    +helpOffers(projectId: string): Observable<Page<HelpOfferView>>
    +answerHelpOffer(projectId: string, offerId: string, decision: string): Observable<HelpOfferView>
  }
  class HttpProjectsApi
  class HelpOfferView {
    +id: string
    +offerer: AuthorSummary
    +role: LookingForRole
    +message: string
    +status: 'pending' | 'accepted' | 'declined'
    +createdAt: string
    +conversationId: string | null
  }
}

package "Backend — Banaro API" {
  class HelpOfferRoutes {
    +POST(request: OfferToHelpRequest, project: Project): HelpOfferResource
    +GET(request: ListHelpOffersRequest, project: Project): Page
  }
  class HelpOfferDecisionRoutes {
    +PUT(request: AnswerHelpOfferRequest, project: Project, offer: HelpOffer): HelpOfferResource
  }
  class ProjectPolicy {
    +offerHelp(user: User | null, project: Project): boolean
    +viewHelpOffers(user: User, project: Project): Response
  }
  class HelpOfferPolicy {
    +answer(user: User, offer: HelpOffer): boolean
  }
  class BlockService {
    +isBlockedEitherWay(a: User, b: User): boolean
  }
  class OfferToHelp {
    +handle(offerer: User, project: Project, role: LookingForRole, message: string): HelpOffer
  }
  class AnswerHelpOffer {
    +handle(owner: User, offer: HelpOffer, decision: HelpOfferStatus): HelpOffer
  }
  class ListHelpOffers {
    +handle(project: Project): Page
  }
  class StartConversation {
    Actions/Messaging
    +handle(...): Conversation
  }
  class HelpOfferPending {
    +code: 'offer_pending'
    +status: 409
  }
  class Project {
    +id: number
    +owner_id: number
  }
  class HelpOffer {
    +id: number
    +project_id: number
    +offerer_id: number
    +role: LookingForRole
    +message: string
    +status: HelpOfferStatus
    +answered_at: Timestamp | null
    +conversation_id: number | null
  }
  enum HelpOfferStatus {
    Pending
    Accepted
    Declined
  }
  class HelpOfferResource
  class HelpOfferedNotification
  class HelpOfferAnsweredNotification
}

OfferToHelpDialog ..> ProjectsApi : uses
ProjectDetailPage ..> OfferToHelpDialog : opens
ProjectDetailPage ..> HelpOfferItem : renders
ProjectDetailPage ..> ProjectsApi : uses
HttpProjectsApi ..|> ProjectsApi
ProjectsApi ..> HelpOfferView : returns
HttpProjectsApi ..> HelpOfferRoutes : HTTPS

HelpOfferRoutes ..> ProjectPolicy : authorize
HelpOfferRoutes ..> OfferToHelp : calls
HelpOfferRoutes ..> ListHelpOffers : calls
HelpOfferDecisionRoutes ..> HelpOfferPolicy : authorize
HelpOfferDecisionRoutes ..> AnswerHelpOffer : calls
ProjectPolicy ..> BlockService : blocked pair check
OfferToHelp ..> HelpOfferPending : throws
OfferToHelp ..> HelpOfferedNotification : queues
AnswerHelpOffer ..> StartConversation : calls on accept
AnswerHelpOffer ..> HelpOfferAnsweredNotification : queues
HelpOfferRoutes ..> HelpOfferResource : returns
Project "1" *-- "*" HelpOffer : helpOffers
HelpOffer --> HelpOfferStatus : has
@enduml
