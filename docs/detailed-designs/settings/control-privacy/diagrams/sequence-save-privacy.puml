@startuml
title UML sequence behaviour — Save privacy settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — banaro application" #E0F2FE
  participant "PrivacySettingsSection" as section
  participant "HttpSettingsApi" as client
end box
box "Backend — Banaro API application" #D1FADF
  participant "PrivacyController" as controller
end box
box "Backend — Banaro Application and Domain" #ECFDF3
  participant "UpdatePrivacySettings" as action
end box
box "Backend — Banaro Infrastructure" #FFF4E5
  database "Banaro database" as db
end box

actor -> section : Open Privacy tab (/settings/privacy)
section --> actor : Current values from GET /api/v1/settings (defaults on a new account, L2-036 criterion 4)
actor -> section : Change visibility, precision or a switch; select "Save changes"
section -> section : submitting state, controls read-only
section -> client : updatePrivacy(PrivacySettings)
client -> controller : PUT /api/v1/settings/privacy
controller -> controller : Authenticate member, validate UpdatePrivacySettingsRequest
alt invalid value
  controller --> client : 422 field errors
  client --> section : invalid state
else valid
  controller -> action : handle(member, values)
  action -> db : UPDATE privacy_settings WHERE user_id = member (L2-036 criterion 1)
  action --> controller : PrivacySettings
  controller --> client : 200 PrivacySettingsResource
  client --> section : PrivacySettings
  section --> actor : success state "Saved"; next responses apply the settings
else server error
  controller --> client : 5xx, settings unchanged
  client --> section : Error
  section --> actor : error with retry; choices kept
end
@enduml
