@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage account settings

Container(web, "Banaro Web", "Angular", "SettingsPage, AccountSettingsSection, SessionsSection, HttpSettingsApi")
ContainerDb(db, "Banaro database", "Relational database", "users, pending_email_changes")
ContainerQueue(redis, "Redis", "Redis", "Sessions and BullMQ queues")

Container_Boundary(api, "Banaro API") {
  Component(settings, "SettingsRoutes", "Route handler", "GET /settings")
  Component(account, "AccountRoutes", "Route handler", "PATCH /settings/account")
  Component(emailChange, "EmailChangeRoutes", "Route handler", "POST /settings/email-change/confirm (src/http/public-routes.ts)")
  Component(password, "PasswordRoutes", "Route handler", "PUT /settings/password")
  Component(sessionsCtrl, "SessionRoutes", "Route handler", "DELETE /settings/sessions/others")
  Component(update, "UpdateAccount / RequestEmailChange", "Actions", "Save name, store pending e-mail change")
  Component(confirm, "ConfirmEmailChange", "Action", "Apply the new address from a valid token")
  Component(change, "ChangePassword", "Action", "Hash new password, revoke other sessions")
  Component(signOut, "SignOutOtherDevices", "Action", "Revoke other sessions")
  Component(registry, "SessionRegistry", "Domain service", "revokeOthers(user, current), revokeAll(user)")
  Component(models, "User / PendingEmailChange", "Drizzle tables", "Account details and pending change")
  Component(notify, "Account notifications", "Queued notifications", "ConfirmNewEmail, EmailChangeRequested, PasswordChanged")
}

Rel(web, settings, "Calls", "JSON/HTTPS")
Rel(web, account, "Calls", "JSON/HTTPS")
Rel(web, emailChange, "Calls", "JSON/HTTPS")
Rel(web, password, "Calls", "JSON/HTTPS")
Rel(web, sessionsCtrl, "Calls", "JSON/HTTPS")
Rel(account, update, "Calls handle()")
Rel(emailChange, confirm, "Calls handle()")
Rel(password, change, "Calls handle()")
Rel(sessionsCtrl, signOut, "Calls handle()")
Rel(change, registry, "Calls revokeOthers()")
Rel(signOut, registry, "Calls revokeOthers()")
Rel(update, models, "Writes")
Rel(confirm, models, "Writes")
Rel(update, notify, "Queues after commit")
Rel(change, notify, "Queues after commit")
Rel(models, db, "Reads and writes", "SQL")
Rel(registry, redis, "Destroys sessions", "Redis protocol")
Rel(notify, redis, "Pushed to", "Redis protocol")
@enduml
