@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Delete an account

Container(web, "Banaro Web", "Angular", "DeleteAccountDialog, DataExportPanel, HttpSettingsApi")
ContainerDb(db, "Banaro database", "Relational database", "users and personal data, data_exports")
ContainerQueue(redis, "Redis", "Redis", "Sessions and Horizon queues")
ContainerDb(media, "Media storage", "Private file storage", "Photos and export archives")

Container_Boundary(api, "Banaro API and Banaro Worker (banaro-api image)") {
  Component(accountCtrl, "AccountController", "Laravel controller", "DELETE /settings/account")
  Component(req, "DeleteAccountRequest", "Form request", "confirmation = DELETE, current password")
  Component(delete, "DeleteAccount", "Action", "Anonymise, delete projects, revoke sessions in one transaction")
  Component(registry, "SessionRegistry", "Domain service", "revokeAll(user)")
  Component(erase, "ErasePersonalData", "Queued job", "Erases profile, photo, messages sent, preferences")
  Component(waitlist, "WaitlistService", "Domain service", "promoteNext(event) for freed places")
  Component(sweep, "EraseDeletedAccounts", "Scheduled command", "Daily re-dispatch before the 30-day deadline")
  Component(exportCtrl, "DataExportController", "Laravel controller", "POST, GET, signed download")
  Component(build, "BuildDataExport", "Queued job", "Writes JSON archive, signs 24-hour link")
  Component(prune, "PruneDataExports", "Scheduled command", "Hourly removal of expired archives")
  Component(models, "User / DataExport", "Eloquent models", "deleted_at, erase_by, erased_at; export status")
}

Rel(web, accountCtrl, "Calls", "JSON/HTTPS")
Rel(web, exportCtrl, "Calls", "JSON/HTTPS")
Rel(accountCtrl, req, "Validates with")
Rel(accountCtrl, delete, "Calls handle()")
Rel(delete, models, "Locks and anonymises")
Rel(delete, registry, "Calls revokeAll()")
Rel(delete, erase, "Dispatches after commit")
Rel(sweep, erase, "Re-dispatches")
Rel(erase, waitlist, "Frees going places via")
Rel(exportCtrl, build, "Dispatches")
Rel(build, models, "Marks ready")
Rel(models, db, "Reads and writes", "SQL")
Rel(erase, db, "Deletes personal data", "SQL")
Rel(erase, media, "Deletes photo", "Storage API")
Rel(build, media, "Writes archive", "Storage API")
Rel(prune, media, "Deletes expired archives", "Storage API")
Rel(registry, redis, "Destroys sessions", "Redis protocol")
@enduml
