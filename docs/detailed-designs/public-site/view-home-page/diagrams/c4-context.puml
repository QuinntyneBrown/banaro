@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — View the home page

Person(visitor, "Visitor", "Person using Banaro without signing in")
Person(member, "Member", "Signed-in, verified builder")
System(banaro, "Banaro", "Connects Christian product builders in Toronto and the GTA")
System_Ext(crawler, "Search engine", "Crawls public pages without running script")

Rel(visitor, banaro, "Reads the home page, then joins or browses", "HTTPS")
Rel(member, banaro, "Opens the home page, goes to the dashboard", "HTTPS")
Rel(crawler, banaro, "Requests / and reads title, description, canonical link", "HTTPS")
@enduml
