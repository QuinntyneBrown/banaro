@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — About and contact

Person(visitor, "Visitor", "Person using Banaro without signing in")
Person(team, "Banaro team", "People who read and answer contact messages")
System(banaro, "Banaro", "Connects Christian product builders in Toronto and the GTA")
System_Ext(mail, "Mail provider", "Delivers transactional e-mail")

Rel(visitor, banaro, "Reads /about, sends a message from /contact", "HTTPS")
Rel(banaro, mail, "Sends contact messages via", "Mailer contract")
Rel(mail, team, "Delivers to the team inbox")
Rel(team, visitor, "Replies by e-mail")
@enduml
