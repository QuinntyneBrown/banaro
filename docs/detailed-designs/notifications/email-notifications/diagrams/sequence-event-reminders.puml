@startuml
title UML sequence behaviour — Send event reminders
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Clock (every 5 minutes)" as clock
box "Backend — Banaro Worker" #ECFDF3
  participant "Scheduler" as scheduler
  participant "SendEventRemindersCommand" as cmd
  participant "NotificationDedupeService" as dedupe
end box
box "Backend — Banaro Infrastructure" #FFF4E5
  queue "Redis" as redis
  database "Banaro database" as db
end box

clock -> scheduler : schedule:run tick
scheduler -> redis : Take onOneServer lock for events:send-reminders
alt lock held by another replica
  redis --> scheduler : Refused; skip (L2-054 criterion 5)
else lock granted
  scheduler -> cmd : Run events:send-reminders
  cmd -> db : Going RSVPs of events not cancelled,\nstarting after now and before now + 24 h + 5 min
  db --> cmd : (event, member) pairs
  loop each pair
    cmd -> dedupe : claim("event-reminder:{event}:{member}")
    dedupe -> db : INSERT notification_dedupe_keys (unique key)
    alt key inserted
      dedupe --> cmd : true
      cmd -> redis : Queue EventReminderNotification on database and mail (L2-029 criterion 1)
    else duplicate key
      dedupe --> cmd : false; already reminded
    end
  end
  cmd --> scheduler : Exit 0
  scheduler -> redis : Release lock
end
note over cmd, db : The mail worker then follows "Queue and send one e-mail":\npreference check, delivery record, retries.
@enduml
