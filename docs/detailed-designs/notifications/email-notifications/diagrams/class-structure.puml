@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — E-mail notifications

package "Backend — Notifications" {
  abstract class MemberNotification <<queued>> {
    +tries: number
    +{abstract} category(): ?EmailCategory
    +channels: string[]
    +shouldSend(member: User): Promise<boolean>
    +backoff(): string[]
    +toMail(notifiable: User): MailMessage
    +failed(e: Throwable): void
  }
  class MatchSuggestionsReadyNotification
  class NewMessageNotification
  class RsvpConfirmedNotification
  class WaitlistPromotedNotification
  class EventReminderNotification
  class FeedbackReceivedNotification
  class HelpOfferedNotification
  class HelpOfferAnsweredNotification
  class WeeklyDigestNotification
  class VerifyEmailNotification
  class MailerChannel {
    +send(notifiable: User, notification: MemberNotification): void
  }
}

package "Backend — Contracts and Integrations" {
  interface Mailer {
    +send(email: OutgoingEmail): MailerReceipt
  }
  class "{Vendor}Mailer" as VendorMailer
  class OutgoingEmail {
    +to: string
    +subject: string
    +html: string
    +text: string
    +headers: Record<string, unknown>
    +idempotencyKey: string
  }
  class MailerReceipt {
    +providerMessageId: string
  }
  class MailerUnavailable <<exception>>
}

package "Backend — Services, Commands and Jobs" {
  class EmailPreferenceService <<settings>> {
    +allows(user: User, category: EmailCategory): boolean
  }
  class UnsubscribeTokenService <<settings>> {
    +issue(user: User, category: EmailCategory): string
  }
  class NotificationDedupeService {
    +claim(key: string): boolean
  }
  class SendEventReminders {
    +signature: 'events:send-reminders'
    +handle(): number
  }
  class SendWeeklyDigests {
    +signature: 'notifications:send-weekly-digest'
    +handle(): number
  }
  class SendWeeklyDigest <<queued>> {
    +userId: number
    +isoWeek: string
    +handle(): void
  }
}

package "Backend — Models" {
  class EmailDelivery {
    +notification_id: string
    +user_id: number
    +category: EmailCategory
    +status: string
    +attempts: number
    +provider_message_id: string | null
    +sent_at: Timestamp | null
    +failed_at: Timestamp | null
  }
  class NotificationDedupeKey {
    +key: string
    +created_at: Timestamp
  }
  enum EmailCategory {
    Matches
    Messages
    Events
    ProjectActivity
    WeeklyDigest
  }
}

MemberNotification <|-- MatchSuggestionsReadyNotification
MemberNotification <|-- NewMessageNotification
MemberNotification <|-- RsvpConfirmedNotification
MemberNotification <|-- WaitlistPromotedNotification
MemberNotification <|-- EventReminderNotification
MemberNotification <|-- FeedbackReceivedNotification
MemberNotification <|-- HelpOfferedNotification
MemberNotification <|-- HelpOfferAnsweredNotification
MemberNotification <|-- WeeklyDigestNotification
MemberNotification <|-- VerifyEmailNotification
MemberNotification --> EmailCategory : category
MemberNotification ..> EmailPreferenceService : shouldSend
MemberNotification ..> MailerChannel : via
MailerChannel ..> Mailer : send
MailerChannel ..> UnsubscribeTokenService : token
MailerChannel --> EmailDelivery : reads and writes
MailerChannel ..> OutgoingEmail : builds
VendorMailer ..|> Mailer
Mailer ..> MailerReceipt : returns
Mailer ..> MailerUnavailable : throws
SendEventReminders ..> NotificationDedupeService : claim
SendEventReminders ..> EventReminderNotification : sends
SendWeeklyDigests ..> SendWeeklyDigest : dispatches
SendWeeklyDigest ..> NotificationDedupeService : claim
SendWeeklyDigest ..> WeeklyDigestNotification : sends
NotificationDedupeService --> NotificationDedupeKey : inserts
@enduml
