@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — E-mail notifications

Person(member, "Member", "Receives e-mail")
System_Ext(mail, "Mail provider", "Delivers transactional e-mail")

System_Boundary(banaro, "Banaro") {
  Container(web, "Banaro Web", "Angular, SSR", "Unsubscribe landing page (settings)")
  Container(api, "Banaro API", "Laravel 11, PHP 8.3", "Feature actions queue notifications after commit; signed unsubscribe route")
  Container(worker, "Banaro Worker", "Laravel Horizon and scheduler", "mail queue, reminders every 5 minutes, weekly digest")
  ContainerDb(db, "Banaro database", "Relational database", "E-mail preferences, delivery records, dedupe keys, RSVPs, notifications")
  ContainerQueue(redis, "Redis", "Redis", "mail queue, scheduler locks")
}

Rel(api, redis, "Queues notifications", "Redis protocol")
Rel(worker, redis, "Takes jobs; holds onOneServer locks", "Redis protocol")
Rel(worker, db, "Reads preferences; writes delivery records and dedupe keys", "SQL")
Rel(worker, mail, "Sends e-mail via", "Mailer contract")
Rel(mail, member, "Delivers e-mail to")
Rel(member, web, "Opens unsubscribe link", "HTTPS")
Rel(web, api, "Signed unsubscribe request", "JSON/HTTPS")
@enduml
