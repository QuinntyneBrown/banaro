@startuml
title UML sequence behaviour — Show the header unread count
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — banaro application" #E0F2FE
  participant "Header bell (shell)" as bell
  participant "UnreadCountStore" as store
  participant "HttpNotificationsApi" as client
end box
box "Backend — Banaro API application" #D1FADF
  participant "NotificationController" as controller
end box
box "Backend — Banaro Application and Domain" #ECFDF3
  participant "CountUnreadNotifications" as action
end box
box "Backend — Banaro Infrastructure" #FFF4E5
  database "Banaro database" as db
end box

actor -> bell : Sign in, navigate, or return focus to the window
bell -> store : refresh()
store -> client : unreadCount()
client -> controller : GET /api/v1/notifications/unread-count
controller -> controller : Authenticate verified member
controller -> action : handle(member)
action -> db : COUNT member.notifications() WHERE read_at IS NULL
db --> action : n
action --> controller : n
controller --> client : 200 { "count": n }
client --> store : n
store --> bell : count signal
alt n = 0
  bell --> actor : Bell without a count
else 1 <= n <= 99
  bell --> actor : Count n, accessible label "n unread notifications" (L2-027 criterion 2)
else n > 99
  bell --> actor : "99+", label states more than 99 unread (L2-027 criterion 2)
end
@enduml
