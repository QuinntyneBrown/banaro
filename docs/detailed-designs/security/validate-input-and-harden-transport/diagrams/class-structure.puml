title Class structure — Validate input and harden transport

package "Frontend — Banaro Web server and api library" {
  class "server.ts securityHeaders" as WebHeaders {
    +handle(req, res, next): void
    -nonce(): string
    -redirectToHttps(req, res): void
  }
  class csrfRecoveryInterceptor <<HttpInterceptorFn>> {
    +intercept(req, next): Observable<HttpEvent>
  }
  class ValidationErrors {
    +fieldErrors: Record<string, string[]>
    +applyTo(form: FormGroup): void
    +firstInvalidField(): string
  }
}

package "Backend — Banaro API" {
  interface RequestSchema {
    +schema: ZodObject
    +authorize(ctx: Ctx): Promise<PolicyResult>
  }
  class "validate()" as Validate <<src/http/validation>> {
    +validate(request: RequestSchema, ctx: Ctx): Promise<Parsed>
    -normalize(input: unknown): unknown
  }
  class ValidationError {
    +errors: Record<string, string[]>
    +status: 422
  }
  class GiveFeedbackRequest {
    +schema: ZodObject
  }
  class ChangePhotoRequest {
    +schema: ZodObject
  }
  class verifyRequestOrigin <<middleware>> {
    +run(ctx: Ctx, next: Next): Promise<Response>
    -originOf(req: Request): string | null
  }
  class securityHeaders <<middleware>> {
    +run(ctx: Ctx, next: Next): Promise<Response>
  }
  class redirectToHttps <<middleware>> {
    +run(ctx: Ctx, next: Next): Promise<Response>
  }
  class SecurityConfig <<src/config/security.ts>> {
    +allowedOrigins: string[]
    +hstsMaxAge: number
    +permissionsPolicy: string
    +apiCsp: string
  }
  class GiveFeedbackData {
    +projectId: number
    +body: string
  }
  class GiveFeedback {
    +handle(member: User, data: GiveFeedbackData): Promise<Feedback>
  }
}


GiveFeedbackRequest ..|> RequestSchema
ChangePhotoRequest ..|> RequestSchema
Validate ..> RequestSchema : authorize, then schema.safeParse
Validate ..> ValidationError : throws
GiveFeedbackRequest ..> GiveFeedbackData : parses to
GiveFeedback ..> GiveFeedbackData : receives
verifyRequestOrigin ..> SecurityConfig : reads
securityHeaders ..> SecurityConfig : reads
redirectToHttps ..> SecurityConfig : reads
csrfRecoveryInterceptor ..> verifyRequestOrigin : retries only csrf_token_mismatch
ValidationErrors ..> ValidationError : maps 422 errors from
@enduml
