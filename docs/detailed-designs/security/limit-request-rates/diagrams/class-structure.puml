title Class structure — Limit request rates

package "Frontend — api library and banaro application" {
  class rateLimitInterceptor <<HttpInterceptorFn>> {
    +intercept(req, next): Observable<HttpEvent>
  }
  class RateLimitedError {
    +limiter: string
    +retryAfterSeconds: number
    +retryAfterMinutes(): number
  }
  interface RateLimitNotice <<RATE_LIMIT_NOTICE>> {
    +notify(error: RateLimitedError): void
  }
  class ToastService {
    +warning(key: string, params?: object): void
  }
  class GiveFeedbackDialog {
    +state: 'default' | 'busy' | 'invalid' | 'failed'
    +errorKey: Signal<string | null>
    +submit(): void
  }
  class SignInPage {
    +errorKey: Signal<string | null>
    +retryMinutes: Signal<number | null>
  }
}

package "Backend — Banaro API" {
  class Limiters <<src/http/rate-limit/limiters.ts>> {
    +api(ctx: Ctx): Limit[]
    +join(ctx: Ctx): Limit[]
    +passwordReset(ctx: Ctx): Limit[]
    +feedback(ctx: Ctx): Limit[]
    +firstMessage(ctx: Ctx): Limit[]
    +contact(ctx: Ctx): Limit[]
  }
  class Limit {
    +key: string
    +max: number
    +windowSeconds: number
  }
  class RedisRateLimiter {
    +hit(key: string, windowSeconds: number): Promise<number>
    +tooManyAttempts(key: string, max: number): Promise<boolean>
    +availableIn(key: string): Promise<number>
    +clear(key: string): Promise<void>
  }
  class throttle <<middleware>> {
    +throttle(name: string): Middleware
  }
  class ClientFingerprint {
    +forRequest(ctx: Ctx): string
    +forEmail(email: string): string
  }
  class AttemptLimiter {
    +tooManyFailures(keys: string[], max: number[]): Promise<boolean>
    +recordFailure(keys: string[], decaySeconds: number): Promise<void>
    +availableIn(keys: string[]): Promise<number>
    +clear(key: string): Promise<void>
  }
  class SignIn {
    +handle(credentials: SignInData, ctx: Ctx): Promise<User>
  }
  class TooManyRequestsError {
    +limiter: string
    +retryAfter: number
  }
}

throttle ..> Limiters : resolves named limiter
throttle ..> RedisRateLimiter : counts in Redis DB 1
throttle ..> ClientFingerprint : logs hashed id
throttle ..> TooManyRequestsError : throws
Limiters ..> Limit : returns
Limiters ..> ClientFingerprint : keys by
AttemptLimiter ..> RedisRateLimiter : wraps
SignIn ..> AttemptLimiter : checks and records
SignIn ..> TooManyRequestsError : throws when exhausted

rateLimitInterceptor ..> RateLimitedError : throws
rateLimitInterceptor ..> RateLimitNotice : general limit
ToastService ..|> RateLimitNotice : bound in app.config.ts
GiveFeedbackDialog ..> RateLimitedError : maps to rateLimit.feedback
SignInPage ..> RateLimitedError : maps to rateLimit.signIn
@enduml
