@startuml
title UML sequence behaviour — Ignore guarded fields
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — banaro application" #E0F2FE
  participant "HttpProjectsApi or a crafted request" as client
end box
box "Backend — Banaro API application" #D1FADF
  participant "Bindings middleware" as binding
  participant "ProjectRoutes" as controller
  participant "UpdateProjectRequest" as request
end box
box "Backend — Banaro Application and Domain" #ECFDF3
  participant "ProjectPolicy" as policy
  participant "UpdateProject" as action
  participant "projects (Drizzle)" as model
end box
box "Backend — Banaro Infrastructure" #FFF4E5
  database "Banaro database" as db
end box

actor -> client : Send body with name, owner_id, role, verified_at
client -> binding : PUT /api/v1/projects/{id}
binding -> model : select where id and ownedBy(member)
model -> db : SELECT ... WHERE id = ? AND owner_id = ?
alt project of another member
  db --> model : No row
  binding --> client : 404 not_found (L2-044 criterion 1)
else own project
  db --> model : Project row
  binding -> policy : update(member, project)
  policy --> binding : allow()
  binding -> controller : PUT(ctx with project)
  controller -> request : validate(UpdateProjectRequest, ctx)
  request -> request : zod object lists name, description, stage only; strips unknown keys
  request --> controller : Parsed data without owner_id, role, verified_at (L2-044 criterion 4)
  controller -> action : handle(project, parsed data)
  action -> model : update(projects).set({ name, description, stage })
  action -> db : UPDATE projects SET name = ? ... WHERE id = ?
  db --> action : Saved
  action --> controller : Project
  controller --> client : 200 ProjectResource; owner and role unchanged
end
@enduml
