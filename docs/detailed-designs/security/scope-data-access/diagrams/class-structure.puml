title Class structure — Scope data access

package "Frontend — api library (lib/auth)" {
  class credentialsInterceptor <<HttpInterceptorFn>> {
    +intercept(req, next): Observable<HttpEvent>
  }
  class unauthorizedInterceptor <<HttpInterceptorFn>> {
    +intercept(req, next): Observable<HttpEvent>
  }
  class authGuard <<CanActivateFn>>
  class adminGuard <<CanActivateFn>>
}

package "Backend — Banaro API" {
  class Scopes <<src/db/scopes.ts>> {
    +ownedBy(table: Table, member: User): SQL
    +withParticipant(member: User): SQL
    +visibleTo(table: Table, viewer: User | null): SQL
  }
  class conversations <<table>> {
    +id: number
  }
  class notifications <<table>> {
    +id: string
    +notifiable_id: number
  }
  class projects <<table>> {
    +id: number
    +owner_id: number
    +is_published: boolean
  }
  class builders <<table>> {
    +id: number
    +user_id: number
  }
  class BlockService {
    +blockedIdsFor(viewer: User): Promise<number[]>
    +isBlockedPair(a: User, b: User): Promise<boolean>
    +forget(viewer: User): Promise<void>
  }
  class ConversationPolicy {
    +view(member: User, conversation: Conversation): PolicyResult
  }
  class ProjectPolicy {
    +view(member: User | null, project: Project): PolicyResult
    +update(member: User, project: Project): PolicyResult
  }
  class PolicyResult {
    +{static} allow(): PolicyResult
    +{static} denyAsNotFound(): PolicyResult
    +{static} deny(): PolicyResult
  }
  class "validate()" as Validate <<src/http/validation>> {
    +validate(request: RequestSchema, ctx: Ctx): Promise<Parsed>
  }
  class UpdateProjectRequest {
    +schema: ZodObject
    +authorize(ctx: Ctx): Promise<PolicyResult>
  }
}

package "Backend — tests/feature/security" {
  interface RouteOwnershipFixture {
    +routeName(): string
    +arrange(owner: User): string[]
    +expectation(): Expectation
    +sentinels(owner: User): string[]
    +isListing(): boolean
    +writableInput(): string[] | null
  }
  enum Expectation {
    NotFound
    Forbidden
    SelfOnly
  }
  class RouteOwnershipRegistry {
    +fixtureFor(routeName: string): RouteOwnershipFixture | null
    +all(): string[]
  }
  class "fixtures/messaging.ts" as MessagingFixtures
  class CrossUserAccessTest {
    +every authenticated route has a fixture
    +a second member cannot reach the owner's records
  }
  class UnauthenticatedAccessTest
  class GuardedFieldsTest
  class ListingVisibilityTest
}

Scopes ..> notifications : ownedBy
Scopes ..> projects : ownedBy, visibleTo
Scopes ..> builders : visibleTo
Scopes ..> conversations : withParticipant
Scopes ..> BlockService : visibleTo() reads
ConversationPolicy ..> PolicyResult : denyAsNotFound()
ProjectPolicy ..> PolicyResult : denyAsNotFound()
ConversationPolicy ..> conversations : guards
ProjectPolicy ..> projects : guards
Validate ..> UpdateProjectRequest : authorize, then schema.parse
UpdateProjectRequest ..> ProjectPolicy : authorize

MessagingFixtures ..|> RouteOwnershipFixture
RouteOwnershipRegistry "1" o-- "*" RouteOwnershipFixture
RouteOwnershipFixture --> Expectation
CrossUserAccessTest ..> RouteOwnershipRegistry : looks up
UnauthenticatedAccessTest ..> RouteOwnershipRegistry
GuardedFieldsTest ..> RouteOwnershipRegistry
ListingVisibilityTest ..> RouteOwnershipRegistry
ListingVisibilityTest ..> BlockService : arranges blocks via
@enduml
