@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Scope data access

Container(web, "Banaro Web", "Angular", "credentialsInterceptor, unauthorizedInterceptor, authGuard, adminGuard")
ContainerDb(db, "Banaro database", "PostgreSQL 16", "Owned and participant records, blocks")
ContainerQueue(redis, "Redis", "Redis", "Sessions, block-list cache")
System_Ext(ci, "CI pipeline", "Runs Vitest")

Container_Boundary(api, "Banaro API") {
  Component(routes, "route.ts stacks and src/http/public-routes.ts", "Route stacks", "Authenticated by default; deliberate anonymous exceptions")
  Component(auth, "auth, requireVerifiedEmail, requireAdministrator", "Middleware", "401 without session, 403 for role routes")
  Component(binding, "Bindings middleware", "src/http/middleware/bindings.ts", "Resolve ids through ownership or participant scope")
  Component(policy, "{Model}Policy", "Policies", "denyAsNotFound() for other members' records")
  Component(request, "{Verb}{Noun}Request", "Request schemas", "zod strips unknown and guarded fields")
  Component(ctrl, "app/api/v1/**/route.ts", "Route handlers", "Call one action, return a resource")
  Component(models, "Owned tables and scopes", "Drizzle tables", "ownedBy, withParticipant and visibleTo conditions")
  Component(block, "BlockService", "Domain service", "blockedIdsFor(), isBlockedPair()")
  Component(resource, "{Noun}Resource", "API resources", "Explicit field lists; hidden fields omitted")
  Component(handler, "Error boundary", "src/http/pipeline.ts", "404 not_found and 401 unauthenticated bodies without detail")
  Component(suite, "CrossUserAccessTest and fixtures", "tests/feature/security", "RouteOwnershipRegistry, GuardedFieldsTest, ListingVisibilityTest")
}

Rel(web, routes, "Calls", "JSON/HTTPS")
Rel(routes, auth, "Applies")
Rel(auth, binding, "Then resolves")
Rel(binding, models, "Queries through scopes")
Rel(binding, policy, "Authorizes with")
Rel(binding, ctrl, "Passes the resolved row to")
Rel(ctrl, request, "Parses with")
Rel(ctrl, models, "Writes parsed fields; owner from the session")
Rel(ctrl, resource, "Returns")
Rel(models, block, "visibleTo() reads block list from")
Rel(block, redis, "Caches block list", "Redis protocol")
Rel(models, db, "Reads and writes", "SQL")
Rel(binding, handler, "Not found raises")
Rel(ci, suite, "Runs")
Rel(suite, routes, "Enumerates and calls every route in-process")
@enduml
