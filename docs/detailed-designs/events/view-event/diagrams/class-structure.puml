@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — View an event

package "Frontend — banaro application, components and api libraries" {
  class EventDetailPage {
    -api: EventsApi
    +event: Signal<EventDetail>
    +rsvp: Signal<RsvpSummary>
    +state: Signal<PageState>
    +load(id: string): void
    +retry(): void
  }
  class AttendeeCluster <<bn-attendee-cluster>> {
    +people: input<BuilderSummary[]>
    +moreCount: input<number>
  }
  interface EventsApi {
    +getEvent(id: string): Observable<EventDetail>
  }
  class HttpEventsApi
  class EventDetail {
    +id: string
    +title: string
    +category: string
    +description: string
    +startsAt: string
    +endsAt: string
    +venueName: string
    +venueAddress: string
    +mapUrl: string
    +host: BuilderSummary
    +goingCount: number
    +capacity: number | null
    +spotsLeft: number | null
    +status: 'scheduled' | 'cancelled'
    +phase: 'upcoming' | 'started' | 'ended'
    +recap: string | null
    +cancellationNote: string | null
    +attendees: AttendeePreview
    +viewerRsvp: RsvpSummary
  }
  class AttendeePreview {
    +people: BuilderSummary[]
    +moreCount: number
  }
  class RsvpSummary {
    +status: 'going' | 'waitlisted' | 'none'
    +waitlistPosition: number | null
  }
}

package "Backend — Banaro API" {
  class EventRoutes {
    +GET(request: ViewEventRequest, event: Event): EventDetailResource
  }
  class ViewEvent {
    +handle(viewer: User, event: Event): EventView
  }
  class EventView {
    +event: Event
    +viewerRsvp: Rsvp | null
    +waitlistPosition: number | null
    +attendeePreview: Collection
    +moreCount: number
  }
  class AttendeeListService {
    +previewFor(event: Event, viewer: User, limit: number): AttendeePreviewResult
  }
  class BlockService <<TrustAndSafety>> {
    +isBlockedEitherWay(a: User, b: User): boolean
  }
  class WaitlistService {
    +positionOf(rsvp: Rsvp): number
  }
  class Event {
    +id: number
    +title: string
    +category: string
    +description: string
    +starts_at: Timestamp
    +ends_at: Timestamp
    +venue_name: string
    +venue_address: string
    +host_id: number
    +recap: string | null
    +cancellation_note: string | null
    +status: EventStatus
    +phase(): string
  }
  class Rsvp {
    +event_id: number
    +user_id: number
    +status: RsvpStatus
  }
  class Builder {
    +user_id: number
    +name: string
    +role: string
  }
  enum RsvpStatus {
    Going
    Waitlisted
  }
  enum EventStatus {
    Scheduled
    Cancelled
  }
  class EventDetailResource
}

EventDetailPage ..> EventsApi : uses
EventDetailPage ..> AttendeeCluster : renders
HttpEventsApi ..|> EventsApi
EventsApi ..> EventDetail : returns
EventDetail *-- AttendeePreview
EventDetail *-- RsvpSummary
HttpEventsApi ..> EventRoutes : HTTPS

EventRoutes ..> ViewEvent : calls
EventRoutes ..> EventDetailResource : returns
EventDetailResource ..> EventView : serializes
ViewEvent ..> EventView : creates
ViewEvent ..> WaitlistService : position via
ViewEvent ..> AttendeeListService : preview via
AttendeeListService ..> BlockService : block rule
AttendeeListService --> Rsvp : queries going
ViewEvent --> Event : loads
Event "1" *-- "*" Rsvp : rsvps
Event --> Builder : host
Rsvp --> RsvpStatus : has
Event --> EventStatus : has
@enduml
