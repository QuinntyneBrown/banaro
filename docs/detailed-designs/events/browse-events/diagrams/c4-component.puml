@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Browse events

Container(web, "Banaro Web", "Angular", "EventsPage, EventMonthGroups, HttpEventsApi")
ContainerDb(db, "Banaro database", "Relational database", "events")

Container_Boundary(api, "Banaro API") {
  Component(routes, "src/http/public-routes.ts", "Route list", "Declares GET /events as anonymous")
  Component(ctrl, "EventRoutes", "Route handler", "index() for GET /events")
  Component(req, "ListEventsRequest", "Request schema", "Validates when, page and per_page")
  Component(action, "ListEvents", "Action", "Upcoming ascending or past descending, paginated")
  Component(model, "Event", "Drizzle table", "Times, venue, capacity, going count")
  Component(resource, "EventSummaryResource", "API resource", "EventSummary JSON shape")
}

Rel(web, routes, "Calls", "JSON/HTTPS")
Rel(routes, ctrl, "Routes to")
Rel(ctrl, req, "Validates with")
Rel(ctrl, action, "Calls handle()")
Rel(ctrl, resource, "Returns collection of")
Rel(action, model, "Queries")
Rel(model, db, "Reads", "SQL")
@enduml
