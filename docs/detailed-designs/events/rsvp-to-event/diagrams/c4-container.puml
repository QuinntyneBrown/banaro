@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — RSVP to an event

Person(member, "Member", "Signed-in, verified builder")
System_Ext(mail, "Mail provider", "Delivers transactional e-mail")

System_Boundary(banaro, "Banaro") {
  Container(web, "Banaro Web", "Angular, SSR", "Event detail page, cancel-rsvp dialog, RSVP toasts")
  Container(api, "Banaro API", "Laravel 11, PHP 8.3", "RSVP, waitlist and cancellation rules")
  Container(worker, "Banaro Worker", "Laravel Horizon", "Sends queued notifications")
  ContainerDb(db, "Banaro database", "Relational database", "Events, RSVPs, notifications")
  ContainerQueue(redis, "Redis", "Redis", "Sessions and Horizon queues")
}

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "PUT and DELETE /api/v1/events/{id}/rsvp", "JSON/HTTPS")
Rel(api, db, "Locks event row, writes RSVPs", "SQL")
Rel(api, redis, "Queues notifications", "Redis protocol")
Rel(worker, redis, "Takes jobs from", "Redis protocol")
Rel(worker, db, "Records database notifications", "SQL")
Rel(worker, mail, "Sends e-mail via", "Mailer contract")
@enduml
