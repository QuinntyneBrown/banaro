@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Deploy and operate data

System_Ext(pipeline, "CI pipeline", "Product <TO SUPPLY>")
System_Ext(orchestrator, "Container orchestrator", "Product <TO SUPPLY>")

System_Boundary(banaro, "Banaro") {
  Container(migrator, "One-off migrate and seed task", "banaro-api image", "node dist/cli.js migrate; seed")
  Container(api, "Banaro API", "Next.js 16, Node 22, banaro-api image", "Serves /api/v1; never migrates on boot")
  Container(worker, "Banaro Worker", "BullMQ worker and scheduler, banaro-api image", "Jobs and scheduled work, once across replicas")
  Container(web, "Banaro Web", "Angular SSR, banaro-web image", "Drains open SSR responses on SIGTERM")
  ContainerDb(db, "Banaro database", "PostgreSQL 16", "Schema and data")
  ContainerDb(redis, "Redis", "Redis", "Migration lock, job schedulers, queues")
}

Rel(pipeline, migrator, "Runs before rollout")
Rel(migrator, db, "Applies migrations, upserts seed data", "SQL")
Rel(migrator, redis, "Takes migration lock", "Redis protocol")
Rel(pipeline, orchestrator, "Requests rollout")
Rel(orchestrator, api, "Probes /health/ready before traffic; SIGTERM to drain", "HTTP")
Rel(orchestrator, worker, "Replaces replicas; SIGTERM to drain")
Rel(orchestrator, web, "Replaces replicas; SIGTERM to drain")
Rel(api, db, "Reads and writes", "SQL")
Rel(worker, redis, "Registers schedules, takes jobs", "Redis protocol")
Rel(worker, db, "Reads and writes", "SQL")
@enduml
