@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Deploy and operate data

package "Backend — database (src/db)" {
  class MigrateCommand <<cli command>> {
    +handle(): Promise<void>
    -withLock(key: string, fn: () => Promise<void>): Promise<void>
  }
  class "SQL migration" as Migration <<drizzle-kit>> {
    +tag: string
    +sql: string
  }
  class ExpandMigration <<convention>> {
    adds tables, nullable columns, indexes
  }
  class ContractMigration <<convention>> {
    drops shapes no running release reads
  }
  class SeedCommand <<cli command>> {
    +handle(): Promise<void>
  }
  interface Seeder {
    +run(db: Database): Promise<void>
  }
  class ReferenceDataSeeder {
    +run(db: Database): Promise<void>
    -upsertBy(table: Table, key: string, rows: Row[]): Promise<void>
  }
  class DemoDataSeeder {
    +run(db: Database): Promise<void>
  }
}

package "Backend — worker and schedule" {
  class Schedules <<src/scheduler.ts>> {
    +mondayMatching: JobScheduler
    +eventReminders: JobScheduler
    +weeklyDigest: JobScheduler
    +register(queue: Queue): Promise<void>
  }
  class JobScheduler <<BullMQ>> {
    +id: string
    +pattern: string
    +tz: string
  }
  class WorkerProcess <<src/worker.ts>> {
    +start(): void
    +pause(): Promise<void>
    +close(): Promise<void>
  }
  class GenerateWeeklySuggestions <<job, matching>>
  class SendEventReminders <<job, email-notifications>>
  class SendWeeklyDigests <<job, email-notifications>>
  class WorkerSettings <<src/config/banaro.ts>> {
    +concurrency: Record<string, number>
    +backoff: number[]
  }
}

package "Pipeline — .ci/" {
  class ReleaseStages <<pipeline>> {
    +build(): void
    +schemaCompat(): void
    +migrate(): void
    +seed(): void
    +rollout(): void
  }
}

Migration <|-- ExpandMigration
Migration <|-- ContractMigration
MigrateCommand ..> Migration : applies pending
Seeder <|.. ReferenceDataSeeder
Seeder <|.. DemoDataSeeder
SeedCommand *-- ReferenceDataSeeder : always
SeedCommand *-- DemoDataSeeder : local and testing only
Schedules *-- "3" JobScheduler
Schedules ..> GenerateWeeklySuggestions : schedules
Schedules ..> SendEventReminders : schedules
Schedules ..> SendWeeklyDigests : schedules
WorkerProcess ..> GenerateWeeklySuggestions : runs
WorkerProcess ..> SendEventReminders : runs
WorkerProcess ..> SendWeeklyDigests : runs
WorkerProcess ..> WorkerSettings : reads
ReleaseStages ..> MigrateCommand : migrate
ReleaseStages ..> SeedCommand : seed
@enduml
