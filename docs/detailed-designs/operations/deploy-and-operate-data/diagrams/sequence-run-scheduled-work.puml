@startuml
title UML sequence behaviour — Run scheduled work once across replicas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Banaro Worker" #ECFDF3
  participant "Scheduler replica A" as schedA
  participant "Scheduler replica B" as schedB
  participant "BullMQ workers (A and B)" as worker
  participant "GenerateWeeklySuggestions" as job
end box
box "Backend — Banaro Infrastructure" #FFF4E5
  database "Redis" as redis
  database "Banaro database" as db
end box

par on start
  schedA -> redis : upsertJobScheduler("monday-matching", Monday 06:00 America/Toronto)
else
  schedB -> redis : upsertJobScheduler("monday-matching", same pattern)
end
redis -> redis : One scheduler record per id; the second upsert changes nothing (L2-054 criterion 5)
note over redis
  Monday 06:00 America/Toronto (L2-022 criterion 1)
end note
redis -> redis : Create one job GenerateWeeklySuggestions for this due time
par
  worker -> redis : Worker A asks for the next job
else
  worker -> redis : Worker B asks for the next job
end
redis --> worker : Job, locked by exactly one worker
worker -> job : handle()
job -> db : Create suggestions
job --> worker : Done
worker -> redis : Mark job completed
opt a job for the same week is still running
  redis -> redis : The deterministic job id refuses a second job for the week
end
@enduml
