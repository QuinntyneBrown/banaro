@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Observe health

package "Backend — Banaro API: health" {
  class "health/live route" as LiveRoute {
    +GET(): Response
  }
  class "health/ready route" as ReadyRoute {
    -service: ReadinessService
    +GET(): Response
  }
  class ReadinessService {
    -checks: HealthCheck[]
    +check(): ReadinessResult
  }
  class ReadinessResult {
    +ready: boolean
    +failedCheck: string | null
  }
  interface HealthCheck {
    +name(): string
    +passes(): boolean
  }
  class DatabaseCheck
  class CacheCheck
  class QueueCheck
}

package "Backend — Banaro API: request logging" {
  class assignRequestId <<middleware>> {
    -pattern = '^[A-Za-z0-9-]{8,64}$'
    +run(ctx: Ctx, next: Next): Promise<Response>
  }
  class logRequest <<middleware>> {
    -startedAt: float
    +run(ctx: Ctx, next: Next): Promise<Response>
    -routeOf(request: Request): string
  }
  class RequestLogLine <<log record>> {
    +request_id: string
    +method: string
    +route: string
    +status: number
    +duration_ms: number
    +member_id: number | null
  }
  class ErrorBoundary <<src/http/pipeline.ts>> {
    +context(): string[]
    +report(e: unknown): void
    +render(e: unknown, ctx: Ctx): Response
  }
  class RequestContext <<AsyncLocalStorage>> {
    +add(key: string, value: unknown): void
    +get(key: string): unknown
  }
}

ReadyRoute --> ReadinessService : calls
ReadinessService ..> ReadinessResult : returns
ReadinessService o-- "3" HealthCheck
DatabaseCheck ..|> HealthCheck
CacheCheck ..|> HealthCheck
QueueCheck ..|> HealthCheck
assignRequestId ..> RequestContext : add request_id
logRequest ..> RequestContext : get request_id
logRequest ..> RequestLogLine : writes
ErrorBoundary ..> RequestContext : get request_id
@enduml
