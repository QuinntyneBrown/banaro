APP_ENV=local
# Derives the session, client-hash and unsubscribe keys. Generate with: openssl rand -base64 32
APP_KEY=
LOG_LEVEL=info
# The address of the API itself, used in one-click unsubscribe links
APP_URL=http://localhost:8100
# First-party Banaro Web origins that get a session and CSRF checks (ADR-0011)
STATEFUL_DOMAINS=localhost:4300,localhost:4301,localhost:8100
BCRYPT_ROUNDS=12
FRONTEND_URL=http://localhost:4300
BANARO_CODE_OF_CONDUCT_VERSION=2026-09-01
BANARO_CONTACT_INBOX=team@banaro.ca
MAIL_HOST=mailpit
MAIL_PORT=1025
# Private media storage for uploads (ADR-0004)
MEDIA_PATH=storage/media
