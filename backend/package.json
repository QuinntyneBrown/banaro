{
  "name": "banaro-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --port 8000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 8000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "banaro": "tsx src/cli.ts",
    "check": "prettier --check . && tsc --noEmit && eslint . && vitest run",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "bullmq": "6.3.10",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.11.1",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
